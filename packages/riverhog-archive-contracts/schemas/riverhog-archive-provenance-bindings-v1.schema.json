{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/riverhog-archive-provenance-bindings-v1.schema.json",
  "$comment": "Structural projection; validate_member_history_binding_page checks exact ID order and bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "bindings"
  ],
  "properties": {
    "format": {
      "const": "riverhog-archive-member-history-bindings/v1"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "x-riverhog-extent": {
        "policy": "segmented_no_total_max",
        "reason": "bounded-archive-member-history-binding-page",
        "progression": "archive-provenance-volume-sequence"
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "bytes",
          "sha256",
          "history_sha256",
          "history_bytes"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "$ref": "#/$defs/nonnegative_count"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "history_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "history_bytes": {
            "$ref": "#/$defs/positive_count"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_count": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "positive_count": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  }
}
