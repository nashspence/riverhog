{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/riverhog-archive-provenance-terminal-v1.schema.json",
  "$comment": "Structural projection; ProvenanceTerminalDocument validates canonical bytes and sequence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "archive_generation", "artifact_set_sha256", "sequence", "kind"],
  "properties": {
    "format": {"const": "riverhog-archive-provenance-terminal/v1"},
    "archive_generation": {"$ref": "#/$defs/sha256"},
    "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {"$ref": "#/$defs/sha256"},
    "kind": {"const": "terminal"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
