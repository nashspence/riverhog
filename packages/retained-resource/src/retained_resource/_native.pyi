from typing import Literal

class Resource:
    def __init__(self, kind: Literal["file", "directory"]) -> None: ...
    @property
    def state(self) -> str: ...
    @property
    def received(self) -> bool: ...
    @property
    def error(self) -> int: ...
    @property
    def metrics(self) -> dict[str, int]: ...
    def acquire(
        self,
        path: bytes | str,
        *,
        writable: bool = False,
        parent: Resource | None = None,
        create: bool = False,
        exclusive: bool = False,
        private_owned: bool = False,
    ) -> None: ...
    def duplicate(self, source: Resource) -> None: ...
    def sync(self) -> None: ...
    def close(self) -> None: ...

class Borrow:
    def __init__(self, owner: Resource) -> None: ...
    @property
    def active(self) -> bool: ...
    @property
    def received(self) -> bool: ...
    def acquire(self) -> None: ...
    def fileno(self) -> int: ...
    def close(self) -> None: ...
