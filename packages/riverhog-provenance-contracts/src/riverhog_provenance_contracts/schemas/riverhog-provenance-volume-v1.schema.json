{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/riverhog-provenance-volume-v1.schema.json",
  "title": "Portable provenance octet segment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "riverhog-provenance-volume/v1"
    },
    "object_id": {
      "$ref": "#/$defs/uuid"
    },
    "segment_index": {
      "$ref": "#/$defs/natural"
    },
    "offset": {
      "$ref": "#/$defs/natural"
    },
    "bytes": {
      "$ref": "#/$defs/natural"
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "object_bytes": {
      "$ref": "#/$defs/natural"
    },
    "object_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "format",
    "object_id",
    "segment_index",
    "offset",
    "bytes",
    "sha256",
    "object_bytes",
    "object_sha256"
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "natural": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6][0-9]{0}|9223372036854775807)(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  }
}
