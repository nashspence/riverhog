@prefix rhp: <https://nashspence.github.io/riverhog/v1/provenance/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://nashspence.github.io/riverhog/v1/provenance/ontology>
    a owl:Ontology ;
    rdfs:label "Riverhog path-independent provenance alignment" ;
    rdfs:comment "An alignment vocabulary, not a claim of complete OWL or PROV-Constraints validation. The JSON schemas and application invariants jointly define the closed-world wire profile. Statements are attributable named graphs; never flatten conflicting claims into unqualified global truth." .

rhp:Artifact a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "A continuing artifact identified under an attributed continuity policy. Not a path, digest, repository key, intellectual-work equivalence, or set of necessarily identical bytes." .
rhp:Occurrence a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "A particular realization or exposure of an artifact, including an object, database value or bounded emission. Simultaneous replicas are distinct occurrences." .
rhp:State a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "A state of an occurrence with fixed aspects. Descriptions of it can be incomplete or conflicting; observing or recording a description does not create this state." .
rhp:Context a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "A qualified naming, source, delivery, execution or recordkeeping context. Does not imply a filesystem, physical host, or responsibility-bearing Agent." .
rhp:Description a owl:Class ; rdfs:subClassOf prov:Entity .
rhp:Observation a owl:Class ; rdfs:subClassOf rhp:Description ;
    rdfs:comment "A direct measurement record generated by a capture activity. Distinct from the observed subject state." .
rhp:ReportedDescription a owl:Class ; rdfs:subClassOf rhp:Description ;
    owl:disjointWith rhp:Observation ;
    rdfs:comment "A documentary description; neither local byte availability nor a fabricated capture activity is required." .
rhp:Activity a owl:Class ; rdfs:subClassOf prov:Activity .
rhp:Capture a owl:Class ; rdfs:subClassOf rhp:Activity .
rhp:Agent a owl:Class ; rdfs:subClassOf prov:Agent .
rhp:AssertionBundle a owl:Class ; rdfs:subClassOf prov:Bundle ;
    rdfs:comment "An immutable attributed set of claims with its own assertion identity, different from the identity of the referent described. Retraction changes acceptance, not historical bytes." .
rhp:Journal a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:comment "A recordkeeping and serialization identity. No single current payload, filesystem location, or global writer coordination is entailed." .
rhp:Entry a owl:Class ; rdfs:subClassOf prov:Bundle ;
    rdfs:comment "An immutable recordkeeping bundle. Append order is not artifact causality or event chronology." .
rhp:QualifiedAssertion a owl:Class .
rhp:LocatorBinding a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:LocatorBindingEnd a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:DeliveryAssociation a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:CustodyAssertion a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:AvailabilityAssertion a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:ContinuityAssertion a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:ContentComparison a owl:Class ; rdfs:subClassOf rhp:QualifiedAssertion .
rhp:Retraction a owl:Class ;
    rdfs:comment "A recordkeeping act withdrawing acceptance of one exact assertion. Not prov:Invalidation of its subject and not an artifact transformation." .

rhp:occurrenceOf a owl:ObjectProperty ; rdfs:domain rhp:Occurrence ; rdfs:range rhp:Artifact ;
    rdfs:comment "Exactly one declared continuity membership in the wire profile. Deliberately not a subproperty of specializationOf, alternateOf, wasDerivedFrom or owl:sameAs." .
rhp:stateOf a owl:ObjectProperty ; rdfs:domain rhp:State ; rdfs:range rhp:Occurrence ;
    rdfs:comment "Exactly one occurrence in the wire profile. Fixed-state membership does not automatically export PROV specialization; that stronger relation requires an explicit assertion." .
rhp:describesState a owl:ObjectProperty ; rdfs:domain rhp:Description ; rdfs:range rhp:State .
rhp:capturedBy a owl:ObjectProperty ; rdfs:domain rhp:Observation ; rdfs:range rhp:Capture ;
    rdfs:subPropertyOf prov:wasGeneratedBy .
rhp:observedState a owl:ObjectProperty ; rdfs:domain rhp:Capture ; rdfs:range rhp:State ;
    rdfs:subPropertyOf prov:used .
rhp:hasSourceContext a owl:ObjectProperty ; rdfs:range rhp:Context .
rhp:hasExecutionContext a owl:ObjectProperty ; rdfs:range rhp:Context .
rhp:hasRecordingContext a owl:ObjectProperty ; rdfs:range rhp:Context .
rhp:assertedBy a owl:ObjectProperty ; rdfs:domain rhp:AssertionBundle ; rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAttributedTo .
rhp:describesReferent a owl:ObjectProperty ; rdfs:domain rhp:AssertionBundle .
rhp:includedIn a owl:ObjectProperty ; rdfs:domain rhp:AssertionBundle ; rdfs:range rhp:Entry .
rhp:previousEntry a owl:ObjectProperty ; rdfs:domain rhp:Entry ; rdfs:range rhp:Entry ;
    rdfs:comment "A sequence/integrity edge only, not PROV derivation, generation or influence." .
rhp:retracts a owl:ObjectProperty ; rdfs:domain rhp:Retraction ; rdfs:range rhp:AssertionBundle .
rhp:bindingTarget a owl:ObjectProperty ; rdfs:domain rhp:LocatorBinding .
rhp:bindingContext a owl:ObjectProperty ; rdfs:domain rhp:LocatorBinding ; rdfs:range rhp:Context .
rhp:deliveryContext a owl:ObjectProperty ; rdfs:domain rhp:DeliveryAssociation ; rdfs:range rhp:Context .
rhp:verifyingObservation a owl:ObjectProperty ; rdfs:domain rhp:DeliveryAssociation ; rdfs:range rhp:Observation .
rhp:custodian a owl:ObjectProperty ; rdfs:domain rhp:CustodyAssertion ; rdfs:range prov:Agent .
rhp:journalSubject a owl:ObjectProperty ; rdfs:domain rhp:Journal ; rdfs:range rhp:Artifact .
rhp:temporalScope a owl:DatatypeProperty ; rdfs:range rdf:JSON ;
    rdfs:comment "Retain the qualified instant/known-bound interval/unknown scope. Do not flatten a historical binding into timeless prov:atLocation or custody into attribution." .
rhp:sourceRepresentation a owl:DatatypeProperty ; rdfs:range rdf:JSON .
rhp:exactAssertion a owl:DatatypeProperty ; rdfs:range rdf:JSON .
rhp:recordedAt a owl:DatatypeProperty ; rdfs:domain rhp:Entry ; rdfs:range xsd:dateTime ;
    rdfs:comment "Recordkeeping timestamp, not an assertion about subject creation or transfer time. Preserve nanosecond source text." .
