from typing import Any

class WriteQuota:
    def __init__(self, forward: tuple[int, ...], recovery: tuple[int, ...]) -> None: ...
    @property
    def recovering(self) -> bool: ...
    @property
    def tracking_bytes(self) -> int: ...
    def admit(self, kind: str, amount: int, offset: int) -> bool: ...
    def resize(self, kind: str, size: int) -> bool: ...
    def resize_report(self) -> dict[str, dict[str, int]]: ...
    def failed(self) -> None: ...
    def report(self) -> dict[str, Any]: ...

compiler: str

class ReadQuota:
    def __init__(
        self, writes: WriteQuota, forward: tuple[int, int], recovery: tuple[int, int]
    ) -> None: ...
    def admit(self, kind: str, amount: int, offset: int) -> bool: ...
    def report(self) -> dict[str, dict[str, int]]: ...

class CallbackQuota:
    def __init__(self, writes: WriteQuota, forward: int, recovery: int) -> None: ...
    def admit(self, error_capable: bool = True) -> bool: ...
    def opened(self) -> bool | None: ...
    def closed(self, forward: bool) -> None: ...
    def abandoned(self, forward: bool) -> None: ...
    def report(self) -> dict[str, Any]: ...

class WriteVfs:
    def __init__(
        self, expected_source_id: str, reads: ReadQuota, callbacks: CallbackQuota
    ) -> None: ...
    def bind(
        self, path: str, native_handle: int, journal_identity: tuple[int, int, int] | None
    ) -> None: ...
    def unbind(self) -> None: ...
    @property
    def bound(self) -> bool: ...
    def arm(self, reads: ReadQuota, callbacks: CallbackQuota) -> None: ...
    def close(self) -> None: ...
    def identity(self) -> dict[str, str]: ...
    @property
    def name(self) -> str: ...
    @property
    def open_files(self) -> int: ...
