from typing import Any

class WriteQuota:
    def __init__(self, forward: tuple[int, ...], recovery: tuple[int, ...]) -> None: ...
    @property
    def recovering(self) -> bool: ...
    @property
    def tracking_bytes(self) -> int: ...
    def admit(self, kind: str, amount: int, offset: int) -> bool: ...
    def resize(self, kind: str, size: int) -> bool: ...
    def resize_report(self) -> dict[str, dict[str, int]]: ...
    def begin_recovery(self) -> None: ...
    def failed(self) -> None: ...
    def report(self) -> dict[str, Any]: ...

compiler: str

class ReadQuota:
    def __init__(
        self, writes: WriteQuota, forward: tuple[int, int], recovery: tuple[int, int]
    ) -> None: ...
    def admit(self, kind: str, amount: int, offset: int) -> bool: ...
    def report(self) -> dict[str, dict[str, int]]: ...

class CallbackQuota:
    def __init__(
        self,
        writes: WriteQuota,
        forward: tuple[int, int],
        recovery: tuple[int, int],
        work: NativeWorkQuota,
        buffers: tuple[int, int],
    ) -> None: ...
    @property
    def work(self) -> NativeWorkQuota: ...
    def admit(self, error_capable: bool = True) -> bool: ...
    def admit_sleep(self, microseconds: int) -> bool: ...
    def admit_buffer(self, amount: int, error_capable: bool = True) -> bool: ...
    def opened(self) -> bool | None: ...
    def closed(self, forward: bool) -> None: ...
    def abandoned(self, forward: bool) -> None: ...
    def report(self) -> dict[str, Any]: ...

class NativeCloseCredit:
    def consume(self) -> None: ...
    def report(self) -> dict[str, int | bool]: ...

class NativeWorkQuota:
    def __init__(
        self, writes: WriteQuota, forward: tuple[int, int], recovery: tuple[int, int]
    ) -> None: ...
    def admit(self, cost: tuple[int, int]) -> bool: ...
    def acquire(
        self, acquisition: tuple[int, int], close: tuple[int, int]
    ) -> NativeCloseCredit | None: ...
    def report(self) -> dict[str, dict[str, int]]: ...

class SqliteProcessBudget:
    def __init__(
        self, expected_source_id: str, heap_bytes: int, native_limits: tuple[int, int]
    ) -> None: ...
    def native_report(self) -> dict[str, int]: ...
    def increase_native(self, native_limits: tuple[int, int]) -> None: ...
    def retry_report(self) -> dict[str, int | str | bool]: ...
    def increase(self, heap_bytes: int) -> None: ...
    def report(self) -> dict[str, int]: ...

def filesystem_cost(method: str, profile: tuple[int, int], amount: int = 0) -> tuple[int, int]: ...
def retry_bootstrap_cost(profile: tuple[int, int]) -> tuple[int, int]: ...
def runtime_identity() -> dict[str, str]: ...
def current_process_budget() -> SqliteProcessBudget: ...

class WriteVfs:
    def __init__(
        self,
        expected_source_id: str,
        reads: ReadQuota,
        callbacks: CallbackQuota,
        heap: SqliteProcessBudget,
    ) -> None: ...
    def retain_custodian(self, custodian: object) -> None: ...
    def complete_custody(self, custodian: object) -> None: ...
    def quarantine(self) -> None: ...
    def bind(
        self, path: str, native_handle: int, journal_identity: tuple[int, int, int] | None
    ) -> None: ...
    def admit_retries(
        self,
        qualified_initial: tuple[int, int],
        selected: tuple[int, int],
        bootstrap: tuple[int, int],
    ) -> None: ...
    def unbind(self) -> None: ...
    @property
    def bound(self) -> bool: ...
    def arm(self, reads: ReadQuota, callbacks: CallbackQuota) -> None: ...
    def close(self) -> None: ...
    def identity(self) -> dict[str, str]: ...
    @property
    def name(self) -> str: ...
    @property
    def open_files(self) -> int: ...
    @property
    def quarantined(self) -> bool: ...
