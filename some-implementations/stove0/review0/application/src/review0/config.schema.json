{
  "$defs": {
    "PrimaryScope": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "minLength": 1,
          "title": "Account",
          "type": "string"
        },
        "service": {
          "minLength": 1,
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "service",
        "account"
      ],
      "title": "PrimaryScope",
      "type": "object"
    },
    "PrimaryStatePolicy": {
      "additionalProperties": false,
      "description": "Configured allocation scope and explicit durable-byte admission.",
      "properties": {
        "control_bytes": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "title": "Control Bytes",
          "type": "integer"
        },
        "inventory_order_bytes": {
          "default": 16777216,
          "minimum": 4096,
          "title": "Inventory Order Bytes",
          "type": "integer"
        },
        "pending_bytes": {
          "default": 268435456,
          "exclusiveMinimum": 0,
          "title": "Pending Bytes",
          "type": "integer"
        },
        "preparation_bytes": {
          "default": 67108864,
          "exclusiveMinimum": 0,
          "title": "Preparation Bytes",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/PrimaryScope"
        },
        "total_bytes": {
          "default": 2147483648,
          "exclusiveMinimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "scope"
      ],
      "title": "PrimaryStatePolicy",
      "type": "object"
    },
    "SamplerConfig": {
      "additionalProperties": false,
      "properties": {
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "base_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Descriptor Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,118}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "image_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Id",
          "type": "string"
        },
        "token_file": {
          "format": "path",
          "title": "Token File",
          "type": "string"
        }
      },
      "required": [
        "id",
        "base_url",
        "token_file",
        "descriptor_sha256",
        "image_id"
      ],
      "title": "SamplerConfig",
      "type": "object"
    }
  },
  "$id": "https://nashspence.github.io/riverhog/v1/config/review0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "primary_state": {
      "$ref": "#/$defs/PrimaryStatePolicy"
    },
    "samplers": {
      "items": {
        "$ref": "#/$defs/SamplerConfig"
      },
      "minItems": 1,
      "title": "Samplers",
      "type": "array"
    },
    "token_file": {
      "format": "path",
      "title": "Token File",
      "type": "string"
    }
  },
  "required": [
    "token_file",
    "primary_state",
    "samplers"
  ],
  "title": "Review0Config",
  "type": "object"
}
