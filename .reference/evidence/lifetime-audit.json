    {
      "claim": "Per-step source/worker/certificate metadata does not subsume prerequisite dependent-row and captured-tail-page checks.",
      "classification": "static equivalence blocker",
      "example": "Delete the completed rank checkpoint last_graph Result while preserving Scan/source/worker metadata; old readiness checks reject before Native, whereas bare inner Native callback predicates do not query that dependency.",
      "id": "C1",
      "observed_in_new_execution": false
    },
    {
      "claim": "A late capacity exception after earlier Native commits can reach the old False return without adopting those commits, leaving outer catalog stamps unchanged on a warm slot.",
      "classification": "new partial-progress protocol needed for deferred adoption",
      "id": "C2",
      "observed_in_new_execution": false
    },
    {
      "claim": "worker_current excludes saved job version/progress; final publish_progress checks both, so deferred adoption detects version-only interference later.",
      "classification": "distinct identity and CAS obligations",
      "id": "C3",
      "observed_in_new_execution": false
    },
    {
      "claim": "Job outcome may already be durable when original close fails; exact slot, construction, storage and lease remain retained and charged.",
      "classification": "existing terminal/receiving invariant",
      "id": "C4",
      "observed_in_new_execution": false
    },
    {
      "claim": "Stop at the first terminal outcome; preserve the original result borrow/check/adopt/drop and separately fenced journal publication.",
      "classification": "required group stop",
      "id": "C5",
      "observed_in_new_execution": false
    }
