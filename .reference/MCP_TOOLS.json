{
  "reference_for": "https://github.com/nashspence/riverhog/issues/959",
  "non_authoritative": true,
  "notes": "Input contract specimen only. Host authorization, ingestion, output pagination and provenance requirements are in INTEGRATION.md. Annotations are not security controls. No running server is supplied.",
  "tools": [
    {
      "name": "list_runs",
      "description": "List authorized, host-admitted observation runs and explicit archival gaps. Never discover arbitrary repositories.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_observations",
      "description": "Read one authorized page of validated, untrusted observations plus coverage and provenance. Not a compliance verdict.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "run_key"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_evidence",
      "description": "Read bounded retained evidence for one observation in an authorized admitted run. No arbitrary file or network fetch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "observation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "run_key",
          "observation_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}
