@@ -87,6 +87,48 @@ def prepare_upload_journal_replay(
     return _commit_binding(factory, work, binding)
 
 
+def is_upload_journal_replay_prepared(
+    factory: SessionFactory,
+    source: source_owner._UploadJournalValidationWork,
+    *,
+    catalog: ContractCatalog,
+) -> bool:
+    """Restore each completed checkpoint once before a prepared Native turn.
+
+    A current source without its exact binding is not positive readiness. Unbound,
+    unfinished and deferred preparation remains with the bounded producers.
+    Last-record checks remain necessary even when the checkpoint headers agree.
+    Native still owns its independent source, worker and frozen-manifest fences.
+    """
+    current, raw = _probe(factory, source)
+    if not current or raw is None:
+        return False
+    binding = _binding(source, catalog)
+    if JournalReplayBinding.from_json(raw) != binding:
+        raise RuntimeError("retained replay inputs differ from the selected attempt")
+
+    from . import upload_journal_epochs as epochs
+    from . import upload_journal_topology as topology
+
+    scan = epochs._begin_scan(factory, source)
+    if scan is None or scan.state != "complete":
+        return False
+    captured = topology._begin(factory, source)
+    if captured is None or captured.state != "complete":
+        return False
+    work = rank._begin(factory, source)
+    if (
+        work is None
+        or work.state != "complete"
+        or not scan.version == captured.version == work.parent.version
+    ):
+        return False
+    current, raw = _probe(factory, source)
+    if raw is not None and JournalReplayBinding.from_json(raw) != binding:
+        raise RuntimeError("retained replay inputs differ from the selected attempt")
+    return current and raw is not None
+
+
