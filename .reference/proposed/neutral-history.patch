+@pytest.mark.parametrize("terminal", [False, True])
+def test_fresh_export_rejects_changed_page_after_shared_history_admission(terminal):
+    fixture = history_fixture(members=2, shared_ancestors=1, source_roots=2)
+    source = fixture.histories[fixture.imports[0].source_history_sha256]
+    path = history_record_page_object_path(source.roots.records_sha256, 0)
+    reads = Counter()
+
+    def read(selected):
+        reads[selected] += 1
+        return (fixture.objects[selected],)
+
+    def opened():
+        return MemberHistoryClosure(
+            MemberHistoryStore(read),
+            lambda journal_id, end: (fixture.journals[journal_id][:end],),
+            member_role="urn:test:member",
+        )
+
+    with opened() as closure:
+        closure.resolve(fixture.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+        original = fixture.objects[path]
+        page = RecordPage.from_json_bytes(original)
+        rows = tuple(
+            row
+            for row in page.records
+            if row["value"]["journal"] == source.primary.journal.to_mapping()
+        )
+        assert len(rows) == 1 < len(page.records)
+        changed = replace(page, records=() if terminal else rows, terminal=terminal).to_json_bytes()
+        assert provenance_structure_identity(changed).relative_path == path
+        fixture.objects[path] = changed
+        before = reads[path]
+        closure.resolve(fixture.bindings[1], extent=RETAINED_HISTORY_EXTENT)
+        assert reads[path] == before
+
+        exported = []
+        with pytest.raises(ProvenanceValidationError, match="admitted identity"):
+            for content in closure.structure_objects():
+                exported.append(content)
+        assert reads[path] == before + 1
+        assert changed not in exported and not closure._cursors
+
+        with opened() as fresh:
+            with pytest.raises(ValueError, match="incomplete or changed"):
+                fresh.resolve(fixture.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+            assert not fresh.contains_structure_object(path)
+            assert tuple(fresh.journal_anchors()) == ()
+            fresh_root = fresh._root
+        assert not fresh_root.exists()
+
+        fixture.objects[path] = original
+        assert set(closure.structure_objects()) == set(fixture.objects.values())
+        root = closure._root
+    assert not root.exists()
+
