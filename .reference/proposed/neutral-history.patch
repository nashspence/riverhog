+@pytest.mark.parametrize("after", [False, True])
+def test_structure_export_receives_original_source_before_exposing_its_bytes(tmp_path, after):
+    fixture = history_fixture()
+    selected = fixture.histories[fixture.bindings[0].history_sha256]
+    target = history_record_page_object_path(selected.roots.records_sha256, 0)
+    path = tmp_path / "page.json"
+    path.write_bytes(fixture.objects[target])
+    streams = []
+    exporting = False
+
+    class Stream:
+        def __init__(self):
+            self.original = path.open("rb")
+            self.closes = 0
+            self.fail = not streams
+
+        def __iter__(self):
+            return self
+
+        def __next__(self):
+            content = self.original.read(128)
+            if not content:
+                raise StopIteration
+            return content
+
+        def close(self):
+            self.closes += 1
+            if self.fail and self.closes == 1:
+                if after:
+                    self.original.close()
+                raise OSError("original source close unconfirmed")
+            self.original.close()
+
+    def read(selected_path):
+        if exporting and selected_path == target:
+            stream = Stream()
+            streams.append(stream)
+            return stream
+        return (fixture.objects[selected_path],)
+
+    with MemberHistoryClosure(
+        MemberHistoryStore(read),
+        lambda journal_id, end: (fixture.journals[journal_id][:end],),
+        member_role="urn:test:member",
+    ) as closure:
+        closure.resolve(fixture.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+        exporting = True
+        exported = []
+        with pytest.raises(OSError, match="original source close unconfirmed"):
+            for content in closure.structure_objects():
+                exported.append(content)
+        assert fixture.objects[target] not in exported and not closure._cursors
+        original = streams[0]
+        assert original.closes == 1 and original.original.closed is after
+        original.close()
+        assert original.closes == 2 and original.original.closed
+        assert set(closure.structure_objects()) == set(fixture.objects.values())
+        assert streams[1].closes == 1 and streams[1].original.closed
+        root = closure._root
+    assert not root.exists()
+
