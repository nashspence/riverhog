+"""Finite neutral histories with independently selectable structural dimensions."""
+
+from __future__ import annotations
+
+import hashlib
+from dataclasses import dataclass
+from typing import Any
+
+from riverhog_archive_contracts import (
+    RETAINED_HISTORY_EXTENT,
+    ArchiveProvenanceIdentity,
+    CollectionArchiveManifest,
+    CollectionArtifactSetIdentity,
+    HistoryJournalAnchor,
+    MemberHistoryBinding,
+    MemberHistoryBuilder,
+    MemberHistoryDocument,
+    MemberHistoryImport,
+    MemberHistoryPrimary,
+    MemberHistoryRoot,
+    ProvenanceRootDocument,
+    ProvenanceRootIdentity,
+    SourceMemberHistoryBindingProof,
+    binding_tree_commitment,
+    provenance_structure_identity,
+)
+from riverhog_provenance import (
+    BoundedSourceObserver,
+    BytesSource,
+    assertion,
+    create_journal,
+    external_reference,
+    new_id,
+    reference,
+    validate_journal,
+)
+
+
+@dataclass
+class NeutralHistory:
+    objects: dict[str, bytes]
+    journals: dict[str, bytes]
+    bindings: tuple[MemberHistoryBinding, ...]
+    histories: dict[str, MemberHistoryDocument]
+    proofs: dict[str, SourceMemberHistoryBindingProof]
+    imports: tuple[MemberHistoryImport, ...]
+    expected_anchors: tuple[HistoryJournalAnchor, ...]
+    primary_state: dict[str, Any]
+
+
+def history_fixture(
+    *,
+    members: int = 1,
+    roots: int = 1,
+    private_imports: int = 0,
+    shared_ancestors: int = 0,
+    source_roots: int = 1,
+    depth: int = 1,
+    imported_extent: str = RETAINED_HISTORY_EXTENT,
+) -> NeutralHistory:
+    """Build actual journals, descriptors, complete sets and source binding proofs.
+
+    Selected members share one valid primary journal and optional documentary
+    roots. Source histories have their own shared documentary roots. Each top
+    member imports its private sources plus the common ancestors; every source
+    may itself import a chain of ``depth`` histories. Sharing a journal does not
+    merge primary delivery identities or selected history extents.
+    """
+
+    assert members >= 1 and roots >= 1 and source_roots >= 1 and depth >= 1
+    assert private_imports >= 0 and shared_ancestors >= 0
+    source_count = (members * private_imports + shared_ancestors) * depth
+    payload = b"neutral member bytes"
+    byte_count, digest = len(payload), hashlib.sha256(payload).hexdigest()
+    ids = tuple(f"{number + 1:064x}" for number in range(members + source_count))
+    observed = BoundedSourceObserver().observe(BytesSource(payload))
+    graph, who = observed.graph_fragment(), observed.observer_agent_id
+    context = assertion("context", who, kind="delivery")
+    associations = {
+        identity: assertion(
+            "delivery_association",
+            who,
+            delivery_context_id=context["id"],
+            slot={"kind": "text", "text": identity},
+            role="urn:test:member",
+            state=reference(observed.state_id, "state"),
+            verification_observation_id=next(
+                row["id"] for row in graph["descriptions"] if row["type"] == "observation"
+            ),
+        )
+        for identity in ids
+    }
+    graph["contexts"] = [*graph.get("contexts", ()), context]
+    graph["delivery_associations"] = list(associations.values())
+    raw = create_journal(graph, recorded_by_agent_id=who)
+    with validate_journal(raw) as summary:
+        primary_anchor = HistoryJournalAnchor.from_mapping(summary.anchor)
+        primary_state = external_reference(summary, observed.state_id)
+    journals = {primary_anchor.journal_id: raw}
+    anchors = [primary_anchor]
+
+    def documentary(count: int) -> tuple[HistoryJournalAnchor, ...]:
+        result = []
+        for _ in range(count):
+            agent_id = new_id()
+            raw = create_journal(
+                {
+                    "agents": [
+                        assertion(
+                            "agent", agent_id, object_id=agent_id, kind="software", name="recorder"
+                        )
+                    ]
+                },
+                recorded_by_agent_id=agent_id,
+            )
+            with validate_journal(raw) as summary:
+                anchor = HistoryJournalAnchor.from_mapping(summary.anchor)
+            journals[anchor.journal_id] = raw
+            result.append(anchor)
+            anchors.append(anchor)
+        return tuple(result)
+
+    selected_roots = documentary(roots - 1)
+    inherited_roots = documentary(source_roots - 1) if source_count else ()
+    objects: dict[str, bytes] = {}
+    histories: dict[str, MemberHistoryDocument] = {}
+    proofs: dict[str, SourceMemberHistoryBindingProof] = {}
+    all_imports = []
+
+    def seal(
+        identity: str,
+        extra_roots: tuple[HistoryJournalAnchor, ...],
+        selected_imports: tuple[MemberHistoryImport, ...],
+    ) -> MemberHistoryBinding:
+        with MemberHistoryBuilder(
+            artifact_id=identity,
+            bytes=byte_count,
+            sha256=digest,
+            primary=MemberHistoryPrimary(primary_anchor, associations[identity]["id"]),
+        ) as builder:
+            for ordinal, anchor in enumerate(extra_roots):
+                builder.add_root(MemberHistoryRoot(anchor, "retained" if ordinal % 2 else "bound"))
+            for imported in selected_imports:
+                builder.add_import(imported)
+            binding, history = builder.seal()
+            for raw in builder.objects():
+                objects[provenance_structure_identity(raw).relative_path] = raw
+        histories[binding.history_sha256] = history
+        all_imports.extend(selected_imports)
+        return binding
+
+    def source_import(binding: MemberHistoryBinding) -> MemberHistoryImport:
+        provenance = ProvenanceRootDocument(
+            archive_generation="1" * 64,
+            artifact_set_sha256=hashlib.sha256(binding.artifact_id.encode()).hexdigest(),
+            delivery_context_id=context["id"],
+            binding_count=1,
+            binding_tree_sha256=binding_tree_commitment((binding,)).root_sha256,
+            journal_count=source_roots,
+            ordered_volume_sha256="3" * 64,
+        )
+        archive = CollectionArchiveManifest(
+            archive_generation=provenance.archive_generation,
+            artifact_set=CollectionArtifactSetIdentity(
+                1, byte_count, provenance.artifact_set_sha256
+            ),
+            ordered_volume_sha256="4" * 64,
+            provenance=ArchiveProvenanceIdentity(
+                provenance.identity,
+                ProvenanceRootIdentity(
+                    id="provenance-root",
+                    kind="provenance-root",
+                    path="provenance/root.json.age",
+                    plaintext_bytes=len(provenance.to_json_bytes()),
+                    sha256=provenance.identity,
+                    stored_bytes=1234,
+                    stored_sha256="5" * 64,
+                ),
+            ),
+        )
+        proof = SourceMemberHistoryBindingProof(
+            "6" * 64, 7, archive.to_json_bytes(), provenance.to_json_bytes(), binding, 0, ()
+        )
+        raw = proof.to_json_bytes()
+        objects[provenance_structure_identity(raw).relative_path] = raw
+        proofs[binding.history_sha256] = proof
+        return MemberHistoryImport(
+            source_identity=proof.source_identity,
+            source_collection_id=proof.collection_id,
+            source_archive_root_sha256=hashlib.sha256(proof.archive_root).hexdigest(),
+            source_artifact_set_sha256=provenance.artifact_set_sha256,
+            source_artifact_id=binding.artifact_id,
+            source_history_sha256=binding.history_sha256,
+            source_binding_proof_sha256=proof.identity,
+            extent=imported_extent,
+            input_state=primary_state,
+        )
+
+    next_source = iter(ids[members:])
+
+    def chain() -> MemberHistoryImport:
+        inherited: tuple[MemberHistoryImport, ...] = ()
+        for _ in range(depth):
+            imported = source_import(seal(next(next_source), inherited_roots, inherited))
+            inherited = (imported,)
+        return inherited[0]
+
+    shared = tuple(chain() for _ in range(shared_ancestors))
+    bindings = tuple(
+        seal(identity, selected_roots, (*shared, *(chain() for _ in range(private_imports))))
+        for identity in ids[:members]
+    )
+    return NeutralHistory(
+        objects,
+        journals,
+        bindings,
+        histories,
+        proofs,
+        tuple(all_imports),
+        tuple(anchors),
+        primary_state,
+    )
