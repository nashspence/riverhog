+"""Complete neutral selections consume verified pages once within one owned attempt."""
+
+from __future__ import annotations
+
+import sqlite3
+from collections import Counter
+from dataclasses import replace
+
+import pytest
+from riverhog_archive_contracts import (
+    BOUND_HISTORY_EXTENT,
+    RETAINED_HISTORY_EXTENT,
+    MemberHistoryStore,
+    RecordPage,
+    history_record_page_object_path,
+    member_history_object_path,
+    source_binding_proof_object_path,
+)
+from riverhog_provenance import MemberHistoryClosure, ProvenanceValidationError
+
+from tests.support.neutral_history import history_fixture
+
+
+def _page_paths(material, authority):
+    for ordinal in range(authority.record_count + 1):
+        path = history_record_page_object_path(authority.records_sha256, ordinal)
+        yield path
+        if RecordPage.from_json_bytes(material.objects[path]).terminal:
+            return
+    raise AssertionError("fixture has no terminal")
+
+
+def _membership(closure):
+    values = {}
+    for table in (
+        "histories",
+        "imports",
+        "snapshots",
+        "journals",
+        "objects",
+        "reference_journals",
+        "reference_assertions",
+    ):
+        cursor = closure._db.execute(f"SELECT * FROM {table} ORDER BY rowid")
+        try:
+            values[table] = cursor.fetchall()
+        finally:
+            cursor.close()
+    return values
+
+
+@pytest.mark.parametrize(
+    "dimensions",
+    [
+        {},
+        {"members": 4},
+        {"roots": 129},
+        {"private_imports": 4},
+        {"shared_ancestors": 4},
+        {"shared_ancestors": 1, "depth": 4},
+        {"members": 4, "shared_ancestors": 1},
+        {"members": 4, "shared_ancestors": 1, "source_roots": 129},
+    ],
+)
+def test_selection_counts_unique_history_work_and_shared_import_edges(dimensions, record_property):
+    material = history_fixture(**dimensions)
+    reads, received, journals, journal_receipts = Counter(), Counter(), Counter(), Counter()
+    heads, statements = [], []
+
+    def read(path):
+        reads[path] += 1
+        try:
+            raw = material.objects[path]
+            for offset in range(0, len(raw), 137):
+                yield raw[offset : offset + 137]
+        finally:
+            received[path] += 1
+
+    def journal(identity, end):
+        journals[identity] += 1
+        try:
+            yield material.journals[identity][:end]
+        finally:
+            journal_receipts[identity] += 1
+
+    expected = Counter()
+    for history in material.histories.values():
+        expected[member_history_object_path(history.identity)] += 1
+        for authority in (history.roots, history.imports):
+            expected.update(_page_paths(material, authority))
+    for imported in material.imports:
+        expected[member_history_object_path(imported.source_history_sha256)] += 1
+        expected[source_binding_proof_object_path(imported.source_binding_proof_sha256)] += 1
+
+    with MemberHistoryClosure(
+        MemberHistoryStore(read, on_storage_open=heads.append),
+        journal,
+        member_role="urn:test:member",
+    ) as closure:
+        closure._db.set_trace_callback(statements.append)
+        for binding in material.bindings:
+            closure.resolve(binding, extent=RETAINED_HISTORY_EXTENT)
+            assert closure._db.in_transaction
+        assert not any(query == "COMMIT" for query in statements)
+        assert reads == received == expected
+        assert journals == journal_receipts
+        assert sum(journals.values()) == len(material.journals) + len(material.imports)
+        assert len(heads) == len(material.histories)
+        assert all(head.cleanup_complete for head in heads)
+        assert set(closure.journal_anchors()) == set(material.expected_anchors)
+        membership = _membership(closure)
+        assert all(row[-1] == 1 for row in membership["histories"])
+        assert all(row[-1] == 1 for row in membership["snapshots"])
+        assert len(membership["histories"]) == len(material.histories)
+        assert len(membership["imports"]) == len(material.imports)
+        source_reads = sum(reads.values())
+        cycle_queries = sum(query.startswith("WITH RECURSIVE descendants") for query in statements)
+        binding_queries = sum(
+            query.startswith("SELECT binding FROM histories") for query in statements
+        )
+        assert cycle_queries == len(material.imports)
+        assert binding_queries == len(material.bindings) + len(material.imports)
+        # Export remains a new authenticated read of every unique structural object.
+        assert list(closure.structure_objects()) == [
+            material.objects[path] for path in sorted(material.objects)
+        ]
+        assert reads == received == expected + Counter(material.objects.keys())
+    assert closure._connection_closed and closure._directory_removed and not closure._cursors
+    record_property(
+        "work_observations",
+        {
+            "dimensions": dimensions,
+            "selected_members": len(material.bindings),
+            "unique_histories": len(material.histories),
+            "import_edges": len(material.imports),
+            "unique_structure_objects": len(material.objects),
+            "selection_structure_reads": source_reads,
+            "export_structure_reads": len(material.objects),
+            "journal_reads": sum(journals.values()),
+            "heads_admissions_and_receipts": len(heads),
+            "cycle_queries": cycle_queries,
+            "binding_queries": binding_queries,
+            "selection_commits": 0,
+        },
+    )
+
+
+@pytest.mark.parametrize("entrypoint", ["resolve", "resolve_import"])
+def test_late_inherited_failure_restores_prior_membership_and_rechecks_retry(entrypoint):
+    material = history_fixture(shared_ancestors=1, source_roots=3)
+    imported = material.imports[-1]
+    source = material.histories[imported.source_history_sha256]
+    terminal = tuple(_page_paths(material, source.roots))[-1]
+    original = material.objects.pop(terminal)
+    denied = False
+    proof_path = source_binding_proof_object_path(imported.source_binding_proof_sha256)
+    reads = Counter()
+
+    def read(path):
+        reads[path] += 1
+        yield material.objects[path]
+        if denied and path == proof_path:
+            raise PermissionError("current source proof fence revoked")
+
+    with MemberHistoryClosure(
+        MemberHistoryStore(read),
+        lambda identity, end: (material.journals[identity][:end],),
+        member_role="urn:test:member",
+    ) as closure:
+        closure.resolve_snapshot(material.expected_anchors[0])
+        before = _membership(closure)
+
+        def selected():
+            if entrypoint == "resolve":
+                closure.resolve(material.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+            else:
+                closure.resolve_import(imported)
+
+        with pytest.raises(KeyError):
+            selected()
+        assert _membership(closure) == before
+        assert list(closure.structure_objects()) == []
+        material.objects[terminal] = original
+        denied = True
+        with pytest.raises(PermissionError, match="fence revoked"):
+            selected()
+        assert _membership(closure) == before
+        denied = False
+        selected()
+        assert set(closure.journal_anchors()) == set(material.expected_anchors)
+        assert reads[proof_path] == 3
+
+
+@pytest.mark.parametrize("failure", ["page_fence", "staging", "journal_fence"])
+def test_interruption_does_not_admit_partial_selection_and_retry_reads_fresh(monkeypatch, failure):
+    material = history_fixture(roots=3)
+    history = material.histories[material.bindings[0].history_sha256]
+    terminal = tuple(_page_paths(material, history.imports))[-1]
+    active = True
+    reads, received = Counter(), Counter()
+
+    def read(path):
+        reads[path] += 1
+        try:
+            yield material.objects[path]
+            if active and failure == "page_fence" and path == terminal:
+                raise InterruptedError("page read fence interrupted")
+        finally:
+            received[path] += 1
+
+    def journal(identity, end):
+        try:
+            yield material.journals[identity][:end]
+        finally:
+            if active and failure == "journal_fence":
+                raise InterruptedError("journal read fence interrupted")
+
+    with MemberHistoryClosure(
+        MemberHistoryStore(read), journal, member_role="urn:test:member"
+    ) as closure:
+        before = _membership(closure)
+        original = closure._snapshot
+
+        def snapshot(anchor):
+            original(anchor)
+            if active and failure == "staging":
+                raise InterruptedError("page staging interrupted")
+
+        monkeypatch.setattr(closure, "_snapshot", snapshot)
+        with pytest.raises(InterruptedError):
+            closure.resolve(material.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+        assert _membership(closure) == before
+        assert reads == received
+        active = False
+        closure.resolve(material.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+        assert set(closure.journal_anchors()) == set(material.expected_anchors)
+        assert reads[member_history_object_path(history.identity)] == 2
+        assert reads == received
+
+
+@pytest.mark.parametrize("extent", [BOUND_HISTORY_EXTENT, RETAINED_HISTORY_EXTENT])
+def test_repeated_history_identity_requires_the_same_complete_binding(extent):
+    material = history_fixture()
+    binding = material.bindings[0]
+    reads = Counter()
+
+    def read(path):
+        reads[path] += 1
+        yield material.objects[path]
+
+    with MemberHistoryClosure(
+        MemberHistoryStore(read),
+        lambda identity, end: (material.journals[identity][:end],),
+        member_role="urn:test:member",
+    ) as closure:
+        closure.resolve(binding, extent=BOUND_HISTORY_EXTENT)
+        before = _membership(closure)
+        prior_reads = reads.copy()
+        with pytest.raises(ProvenanceValidationError, match="binding differs"):
+            closure.resolve(replace(binding, bytes=binding.bytes + 1), extent=extent)
+        assert _membership(closure) == before and reads == prior_reads
+        closure.resolve(binding, extent=extent)
+
+
+def test_bound_then_retained_keeps_full_selected_and_inherited_history():
+    material = history_fixture(roots=3, shared_ancestors=1, source_roots=3)
+    binding = material.bindings[0]
+    with MemberHistoryClosure(
+        MemberHistoryStore(lambda path: (material.objects[path],)),
+        lambda identity, end: (material.journals[identity][:end],),
+        member_role="urn:test:member",
+    ) as closure:
+        closure.resolve(binding, extent=BOUND_HISTORY_EXTENT)
+        bound = set(closure.journal_anchors())
+        closure.resolve(binding, extent=RETAINED_HISTORY_EXTENT)
+        retained = set(closure.journal_anchors())
+        assert bound < retained == set(material.expected_anchors)
+        assert len(_membership(closure)["histories"]) == len(material.histories) + 1
+        assert set(closure.structure_objects()) == set(material.objects.values())
+
+
+def test_resolutions_retain_the_owned_transaction_across_membership_image_commit():
+    material = history_fixture(members=2)
+    statements = []
+    with MemberHistoryClosure(
+        MemberHistoryStore(lambda path: (material.objects[path],)),
+        lambda identity, end: (material.journals[identity][:end],),
+        member_role="urn:test:member",
+    ) as closure:
+        closure._db.set_trace_callback(statements.append)
+        closure.resolve(material.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+        assert closure._db.in_transaction
+        assert statements.count("BEGIN") == 1 and statements.count("COMMIT") == 0
+        assert closure.membership_image(max_bytes=1024 * 1024) is not None
+        assert not closure._db.in_transaction and statements.count("COMMIT") == 1
+        closure.resolve(material.bindings[1], extent=RETAINED_HISTORY_EXTENT)
+        assert closure._db.in_transaction
+        assert statements.count("BEGIN") == 2 and statements.count("COMMIT") == 1
+
+
+@pytest.mark.parametrize("after", [False, True])
+def test_uncertain_selection_cursor_close_freezes_owner_until_original_receiving(after):
+    material = history_fixture()
+    cursors, connections = [], []
+
+    class UncertainCursor:
+        def __init__(self, actual):
+            self.actual, self.close_calls = actual, 0
+
+        def close(self):
+            self.close_calls += 1
+            if self.close_calls == 1:
+                if after:
+                    self.actual.close()
+                raise OSError("selection cursor close unconfirmed")
+            self.actual.close()
+
+    class Connection(sqlite3.Connection):
+        def execute(self, statement, parameters=()):
+            actual = super().execute(statement, parameters)
+            if statement == "RELEASE history_selection":
+                cursor = UncertainCursor(actual)
+                cursors.append(cursor)
+                return cursor
+            return actual
+
+    def connect(path):
+        actual = sqlite3.connect(path, factory=Connection)
+        connections.append(actual)
+        return actual
+
+    owner = MemberHistoryClosure(
+        MemberHistoryStore(lambda path: (material.objects[path],)),
+        lambda identity, end: (material.journals[identity][:end],),
+        member_role="urn:test:member",
+        connection_factory=connect,
+    )
+    with pytest.raises(OSError, match="cursor close unconfirmed"), owner:
+        owner.resolve(material.bindings[0], extent=RETAINED_HISTORY_EXTENT)
+    assert owner._closing and owner._root.exists() and owner._cursors == {cursors[0]}
+    assert cursors[0].close_calls == 1
+    with pytest.raises(RuntimeError, match="closed"):
+        list(owner.journal_anchors())
+    owner.close()
+    assert cursors[0].close_calls == 2 and not owner._cursors
+    assert owner._connection_closed and owner._directory_removed and not owner._root.exists()
+    with pytest.raises(sqlite3.ProgrammingError, match="closed"):
+        connections[0].execute("SELECT 1")
