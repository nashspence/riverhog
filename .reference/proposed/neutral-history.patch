+@pytest.mark.parametrize("failure", [None, "oversized", "type", "interrupted"])
+def test_bounded_history_read_receives_original_iterator_on_every_exit(tmp_path, failure):
+    path = tmp_path / "history"
+    path.write_bytes(b"history")
+
+    class Stream:
+        def __init__(self):
+            self.original = path.open("rb")
+            self.closes = 0
+            self.reads = 0
+
+        def __iter__(self):
+            return self
+
+        def __next__(self):
+            self.reads += 1
+            if failure == "type":
+                return bytearray(b"history")
+            if failure == "interrupted" and self.reads == 2:
+                raise InterruptedError("source interrupted")
+            chunk = self.original.read(3)
+            if not chunk:
+                raise StopIteration
+            return chunk
+
+        def close(self):
+            self.closes += 1
+            self.original.close()
+
+    source = Stream()
+    if failure is None:
+        assert read_bounded_history_object(source, 7) == b"history"
+    else:
+        with pytest.raises(InterruptedError if failure == "interrupted" else ValueError):
+            read_bounded_history_object(source, 1 if failure == "oversized" else 7)
+    assert source.closes == 1 and source.original.closed
+
+
+@pytest.mark.parametrize("after", [False, True])
+def test_bounded_history_read_requires_original_close_acknowledgement(tmp_path, after):
+    path = tmp_path / "history"
+    path.write_bytes(b"history")
+
+    class Stream:
+        def __init__(self):
+            self.original = path.open("rb")
+            self.closes = 0
+
+        def __iter__(self):
+            return self
+
+        def __next__(self):
+            chunk = self.original.read(3)
+            if not chunk:
+                raise StopIteration
+            return chunk
+
+        def close(self):
+            self.closes += 1
+            if self.closes == 1:
+                if after:
+                    self.original.close()
+                raise OSError("source close unconfirmed")
+            self.original.close()
+
+    source = Stream()
+    with pytest.raises(OSError, match="source close unconfirmed"):
+        read_bounded_history_object(source, 7)
+    assert source.closes == 1 and source.original.closed is after
+    source.close()
+    assert source.closes == 2 and source.original.closed
