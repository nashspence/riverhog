+def child_archive(tmp_path, monkeypatch, program):
+    source = tmp_path / "archive"
+    source.mkdir()
+    (source / "object.age").write_bytes(b"test child, not ciphertext")
+    processes = []
+    popen = subprocess.Popen
+    def launch(args, **kwargs):
+        assert kwargs["stderr"] == subprocess.DEVNULL
+        assert kwargs["stdout"] == subprocess.PIPE
+        assert "secret" not in repr(args)
+        child = popen([sys.executable, "-c", program], **kwargs)
+        processes.append(child)
+        return child
+    monkeypatch.setattr(archive_io.subprocess, "Popen", launch)
+    encrypted = archive_io.EncryptedArchive(
+        source, passphrase="secret", age_command="controlled-test-child", scratch=tmp_path / "scratch"
+    )
+    return encrypted, processes
+
