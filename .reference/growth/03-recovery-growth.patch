+@pytest.mark.parametrize("maximum", [0, 1, 127, 128 * 1024, 128 * 1024 + 7])
+@pytest.mark.parametrize("extra", [0, 1, 1000000])
+def test_bounded_consumer_pulls_at_most_one_rejection_sentinel(maximum, extra):
+    class Observed(io.BytesIO):
+        count = 0
+        def read(self, size=-1):
+            assert 0 < size <= archive_io._PLAINTEXT_READ_BYTES
+            chunk = super().read(size)
+            self.count += len(chunk)
+            return chunk
+    source = Observed(b"x" * (maximum + extra))
+    if extra:
+        with pytest.raises(ValueError, match="plaintext bound"):
+            archive_io._bounded_plaintext(source, maximum)
+        assert source.count == maximum + 1
+    else:
+        assert archive_io._bounded_plaintext(source, maximum) == b"x" * maximum
+        assert source.count == maximum
+    binding = growth_binding(archive_io._bounded_plaintext)
+    validate_sample(project_bindings((binding,)), binding.declaration.id,
+                    {"maximum": maximum}, {"read_octets": source.count, "scratch_octets": 0})
+
+
+@pytest.mark.parametrize("maximum", [True, -1, 1.0])
+def test_invalid_bound_never_pulls_a_stream(maximum):
+    class Unreadable:
+        def read(self, *args):
+            pytest.fail("invalid bound reached reader")
+    with pytest.raises(ValueError):
+        archive_io._bounded_plaintext(Unreadable(), maximum)
