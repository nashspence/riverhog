+def test_over_budget_child_is_killed_without_plaintext_scratch(tmp_path, monkeypatch):
+    encrypted, children = child_archive(tmp_path, monkeypatch,
+        'import os,time; os.write(1,b"x"*10000); time.sleep(60)')
+    with pytest.raises(ValueError, match="plaintext bound"):
+        encrypted.read_bounded("object.age", 7)
+    assert children[0].poll() is not None
+    assert not list(encrypted.scratch.iterdir())
