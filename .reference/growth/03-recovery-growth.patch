+def test_preparation_does_not_cache_or_trust_changed_payloads(tmp_path):
+    root, objects, expected = corpus(1, 1)
+    reader = reader_for(root, objects, Counter())
+    with reader.prepared(scratch=tmp_path):
+        raw = next(iter(expected.values()))
+        path = next(p for p,v in objects.items() if v == raw)
+        objects[path] = b"z" * len(raw)
+        with pytest.raises(ProvenanceArchiveReadError, match="segment changed"):
+            list(reader.iter_journal_range(next(iter(expected))))
+
