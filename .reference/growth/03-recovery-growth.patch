+    MemberHistoryBinding, ProvenancePayload, ProvenanceRootDocument,
+    ProvenanceTerminalDocument, ProvenanceVolumeDocument,
+    binding_tree_commitment, ordered_provenance_commitment,
+)
+from riverhog_canonical_json import canonical_json_bytes
+from riverhog_growth_contracts import growth_binding, project_bindings, validate_sample
+
+
+def digest(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def corpus(journals: int, segments: int):
+    """Exact structural custody; synthetic journal bytes are not semantic journals."""
+    generation, artifacts = "a" * 64, "b" * 64
+    member = MemberHistoryBinding("c" * 64, 0, digest(b""), "d" * 64, 1)
+    bindings = canonical_json_bytes({
+        "format": "riverhog-archive-member-history-bindings/v1",
+        "bindings": [member.to_mapping()],
+    })
+    first = ProvenancePayload("bindings", 0, len(bindings), digest(bindings))
+    documents = [ProvenanceVolumeDocument(
+        generation, artifacts, 0, first, first_artifact_id=member.artifact_id,
+        last_artifact_id=member.artifact_id, binding_count=1,
+    )]
+    objects = {first.path: bindings}
+    expected = {}
+    for ordinal in range(journals):
+        journal_id = f"urn:uuid:00000000-0000-4000-8000-{ordinal:012x}"
+        chunks = [f"journal {ordinal} segment {i}\n".encode() for i in range(segments)]
+        raw = b"".join(chunks)
+        expected[journal_id] = raw
+        offset = 0
+        for chunk in chunks:
+            sequence = len(documents)
+            payload = ProvenancePayload("journal", sequence, len(chunk), digest(chunk))
+            documents.append(ProvenanceVolumeDocument(
+                generation, artifacts, sequence, payload, journal_id=journal_id,
+                journal_offset=offset, journal_bytes=len(raw), journal_sha256=digest(raw),
+            ))
+            objects[payload.path] = chunk
+            offset += len(chunk)
+    terminal = ProvenanceTerminalDocument(generation, artifacts, len(documents))
+    root = ProvenanceRootDocument(
+        generation, artifacts, "urn:uuid:00000000-0000-4000-8000-000000000fff",
+        1, binding_tree_commitment((member,)).root_sha256, journals,
+        ordered_provenance_commitment((*documents, terminal)),
+    )
+    objects["provenance/root.json.age"] = root.to_json_bytes()
+    for document in (*documents, terminal):
+        objects[document.metadata_path] = document.to_json_bytes()
+    return root, objects, expected
+
+
+def reader_for(root, objects, reads):
+    def read(path):
+        reads[path] += 1
+        yield objects[path]
+    return CanonicalProvenanceArchiveReader(
+        read, expected_root_sha256=root.identity,
+        archive_generation=root.archive_generation, artifact_set_sha256=root.artifact_set_sha256,
+    )
+
+
+@pytest.mark.parametrize("journals", [1, 4, 16, 64])
+@pytest.mark.parametrize("segments", [1, 3])
+def test_prepared_journal_recovery_has_one_cold_descriptor_pass(tmp_path, journals, segments):
+    root, objects, expected = corpus(journals, segments)
+    reads = Counter()
+    reader = reader_for(root, objects, reads)
+    with reader.prepared(scratch=tmp_path):
+        summary = reader.scan()
+        cold_reads = reads.copy()
+        for journal_id, byte_count, sha in reader.iter_journal_headers():
+            raw = b"".join(reader.iter_journal_range(journal_id))
+            assert raw == expected[journal_id] and (len(raw), digest(raw)) == (byte_count, sha)
+        assert len(list(reader.iter_bindings())) == 1
+        with reader.prepared(scratch=tmp_path):
+            assert reader.scan() == summary
+        assert reader._prepared_db is not None
+        plan = reader._prepared_db.execute(
+            "EXPLAIN QUERY PLAN SELECT kind,body FROM volumes "
+            "WHERE journal=? AND kind=? ORDER BY sequence", (next(iter(expected)), "journal")
+        ).fetchall()
+        assert any("SEARCH" in row[3] and "volume_journals" in row[3] for row in plan)
+        assert not any("TEMP B-TREE" in row[3] for row in plan)
+        with pytest.raises(sqlite3.OperationalError):
+            reader._prepared_db.execute("DELETE FROM volumes")
+        binding = growth_binding(CanonicalProvenanceArchiveReader._scan)
+        validate_sample(project_bindings((binding,)), binding.declaration.id,
+            {"volumes": 1 + journals * segments},
+            {"root_reads": cold_reads["provenance/root.json.age"],
+             "descriptor_reads": sum(n for p,n in cold_reads.items() if "/metadata/" in p),
+             "payload_reads": sum(n for p,n in cold_reads.items() if "/payloads/" in p)})
+    assert reader._prepared_db is None and not reader._prepared_cursors
+    assert not list(tmp_path.iterdir())
+    assert all(reads[p] == 1 for p in objects if "/metadata/" in p or p.endswith("root.json.age"))
+
+
+def test_partial_iterator_closes_and_next_context_revalidates(tmp_path):
+    root, objects, expected = corpus(4, 2)
+    reads = Counter()
+    reader = reader_for(root, objects, reads)
+    with reader.prepared(scratch=tmp_path):
+        rows = reader._descriptors(kind="journal")
+        next(rows)
+        assert reader._prepared_cursors
+    rows.close()
+    assert not reader._prepared_cursors
+    terminal = sorted(p for p in objects if "/metadata/" in p)[-1]
+    objects[terminal] = objects[terminal].replace(b'"terminal"', b'"invalid"')
+    with pytest.raises(ValueError):
+        with reader.prepared(scratch=tmp_path):
+            pytest.fail("unverified index was exposed")
+    assert reads["provenance/root.json.age"] == 2
+    assert reader._prepared_db is None and not list(tmp_path.iterdir())
+
