--- /dev/null
+++ b/some-implementations/riverhog/storage/filesystem/tests/test_materialize_growth.py
@@ -0,0 +1,49 @@
+"""Growth witnesses for local materialization state, not timing promises."""
+from __future__ import annotations
+
+import sqlite3
+
+import pytest
+from a_riverhog_filesystem_store.materialize import (
+    _cleanup_inactive_generations, _initialize_state,
+)
+
+
+@pytest.mark.parametrize("rows_per_generation", [1, 512, 2048, 8192])
+def test_cleanup_seeks_past_active_rows_between_bounded_delete_batches(rows_per_generation):
+    db = sqlite3.connect(":memory:")
+    try:
+        _initialize_state(db)
+        db.execute("INSERT INTO authority VALUES ('active_generation','active')")
+        for generation in ("active", "z-abandoned"):
+            db.execute("INSERT INTO projection_generation(generation,status) VALUES (?, 'complete')",
+                       (generation,))
+            db.executemany("INSERT INTO projection VALUES (?, ?, ?, '{}', 2, 0)",
+                           ((generation, str(i), str(i)) for i in range(rows_per_generation)))
+            db.executemany("INSERT INTO projection_part VALUES (?, ?, 1, 0, 0, ?)",
+                           ((generation, str(i), 'a'*64) for i in range(rows_per_generation)))
+        db.commit()
+        statements = []
+        steps = 0
+        def progress():
+            nonlocal steps
+            steps += 1
+            return 0
+        db.set_trace_callback(statements.append)
+        db.set_progress_handler(progress, 1)
+        _cleanup_inactive_generations(db)
+        db.set_progress_handler(None, 0)
+        db.set_trace_callback(None)
+        for table in ('projection', 'projection_part'):
+            assert db.execute(f'SELECT COUNT(*) FROM {table}').fetchone()[0] == rows_per_generation
+            assert db.execute(f'SELECT COUNT(*) FROM {table} WHERE generation="active"').fetchone()[0] == rows_per_generation
+            queries = [q for q in statements if q.startswith(f'SELECT rowid FROM {table} WHERE')]
+            assert all('rowid >' in q for q in queries[1:])
+        # A regression ceiling on the actual SQLite VM, not a cross-version CPU
+        # or physical page-I/O promise. Query shape supplies the algorithm argument.
+        assert steps <= 200 * (4 * rows_per_generation + 2)
+        assert db.execute('SELECT generation FROM projection_generation').fetchall() == [('active',)]
+        _cleanup_inactive_generations(db)
+        assert db.execute('SELECT COUNT(*) FROM projection').fetchone()[0] == rows_per_generation
+    finally:
+        db.close()
