+@dataclass(frozen=True)
+class ValidationWork:
+    """An executable workload and its locally owned, report-only timing expectation."""
+
+    name: str
+    command: tuple[str, ...]
+    target_seconds: float | None = None
+    boundary: str = "command-including-owned-preparation-and-cleanup"
+    conditions: tuple[tuple[str, str], ...] = ()
+
+    def __post_init__(self) -> None:
+        if not self.name or not self.command or not all(self.command):
+            raise ValueError("validation work requires a name and a command")
+        value = self.target_seconds
+        if value is not None and (
+            type(value) not in (int, float) or not math.isfinite(value) or value <= 0
+        ):
+            raise ValueError("runtime targets must be positive finite seconds")
+        if not self.boundary or len(dict(self.conditions)) != len(self.conditions):
+            raise ValueError("validation work requires an exact boundary and unique conditions")
+
+    def definition(self) -> dict[str, object]:
+        return {
+            "name": self.name,
+            "command": list(self.command),
+            "target_seconds": self.target_seconds,
+            "boundary": self.boundary,
+            "conditions": dict(self.conditions),
+            "report_only": True,
+        }
+
+
+def validation_workloads() -> tuple[ValidationWork, ...]:
+    """Derive executable work from the shared plan; absent targets are not approvals."""
+    work = [ValidationWork(name, ("make", name)) for name in REPOSITORY_TARGETS]
+    work.extend(
+        ValidationWork(f"unit-{name}", ("make", "unit-shard", f"UNIT_SHARD={name}"))
+        for name in SHARDS
+    )
+    work.extend(
+        ValidationWork(f"image-{name}", ("make", "image-qualification", f"IMAGE_GROUP={name}"))
+        for name in IMAGE_GROUPS
+    )
+    work.extend(
+        ValidationWork(f"compose-{name}", ("make", "compose-shard", f"COMPOSE_LANE={name}"))
+        for name in COMPOSE_LANES
+    )
+    work.extend(
+        ValidationWork(name, ("make", name))
+        for name in ("unit", "build", "client-platform-qualification", "linux-qualification")
+    )
+    work.append(
+        ValidationWork("check-in", ("make", "-j1", "lint", "unit", "dist-smoke", "build"))
+    )
+    work.append(
+        ValidationWork(
+            "stove0-scale",
+            (
+                "make",
+                "--no-print-directory",
+                "stove0-scale-qualification",
+                "STOVE0_SCALE_FILES=128",
+                "STOVE0_SCALE_AUDIO_FRAMES=2000",
+                "RIVERHOG_CI_IMAGES_PREBUILT=1",
+            ),
+            target_seconds=600,
+            boundary="complete-lifecycle-after-verified-image-preparation",
+            conditions=(
+                ("audio_files", "128"),
+                ("audio_frames", "2000"),
+                ("sidecar_files", "1"),
+                ("images", "prepared-and-verified-at-the-tested-source"),
+            ),
+        )
+    )
+    if len({item.name for item in work}) != len(work):
+        raise ValueError("each validation workload must have exactly one definition")
+    return tuple(work)
+
+
+def validation_work(name: str) -> ValidationWork:
+    for work in validation_workloads():
+        if work.name == name:
+            return work
+    raise ValueError(f"unknown maintained validation workload: {name}")
+
+
+def require_runtime_targets(names: Sequence[str]) -> tuple[ValidationWork, ...]:
+    """Consumers must not silently turn missing approvals into unlimited budgets."""
+    if not names or len(set(names)) != len(names):
+        raise ValueError("expected workloads must be nonempty and unique")
+    work = tuple(validation_work(name) for name in names)
+    missing = [item.name for item in work if item.target_seconds is None]
+    if missing:
+        raise ValueError(f"runtime target approval required: {', '.join(missing)}")
+    return work
+
+
 def run(command: Sequence[str], *, env: dict[str, str] | None = None) -> None:
     subprocess.run(command, cwd=ROOT, env=env, check=True)
 
