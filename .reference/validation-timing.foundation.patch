+def validation_comparison(
+    definition: dict[str, object],
+    *,
+    elapsed: object,
+    exit_status: object,
+    source_clean: object,
+) -> dict[str, object]:
+    """Compare measured completion, never make elapsed time a command failure."""
+    if (
+        type(elapsed) not in (int, float)
+        or not math.isfinite(cast(float, elapsed))
+        or cast(float, elapsed) < 0
+    ):
+        raise ValueError("invalid validation elapsed time")
+    if type(exit_status) is not int or type(source_clean) is not bool:
+        raise ValueError("invalid validation completion state")
+    target = definition["target_seconds"]
+    if target is not None and (
+        type(target) not in (int, float)
+        or not math.isfinite(cast(float, target))
+        or cast(float, target) <= 0
+    ):
+        raise ValueError("invalid validation runtime target")
+    reason = "completed-command"
+    if exit_status:
+        reason = "command-failed"
+    elif target is None:
+        reason = "target-unapproved"
+    elif not source_clean:
+        reason = "source-unverified"
+    status = "not-compared"
+    if reason == "completed-command":
+        status = "met" if cast(float, elapsed) < cast(float, target) else "missed"
+    return {
+        "report_only": True,
+        "target_seconds": target,
+        "status": status,
+        "reason": reason,
+    }
+
+
+def execute_validation(name: str, output: Path, run_id: str) -> int:
+    """Run exactly the shared plan's command and retain start and terminal evidence."""
+    from scripts.ci_qualification import ROOT, validation_work
+
+    if re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", run_id) is None:
+        raise ValueError("invalid validation run identifier")
+    work = validation_work(name)
+    if output.exists():
+        raise ValueError("validation evidence must not overwrite another invocation")
+    source = source_identity(ROOT)
+    definition = work.definition()
+    record: dict[str, object] = {
+        "format": "riverhog-ci-validation-timing/v1",
+        **source,
+        "run_id": run_id,
+        "definition": definition,
+        "state": "running",
+    }
+    # A killed parent leaves an incomplete record, not an absent run or false success.
+    write_record(output, record)
+    env = {**os.environ, "RIVERHOG_CI_LANE": name, "RIVERHOG_CI_RUN_ID": run_id}
+    started = time.monotonic()
+    timer = None
+    if work.target_seconds is not None:
+        timer = Timer(
+            work.target_seconds,
+            lambda: print(
+                f"Validation target exceeded while {name} is running (report only).",
+                file=sys.stderr,
+                flush=True,
+            ),
+        )
+        timer.daemon = True
+        timer.start()
+    state = "completed"
+    status = 2
+    try:
+        status = subprocess.run(work.command, cwd=ROOT, env=env, check=False).returncode
+    except OSError:
+        state = "launch-failed"
+    except KeyboardInterrupt:
+        state, status = "interrupted", 130
+    finally:
+        elapsed = time.monotonic() - started
+        if timer is not None:
+            timer.cancel()
+        after = source_identity(ROOT)
+        comparison = validation_comparison(
+            definition,
+            elapsed=elapsed,
+            exit_status=status,
+            source_clean=source.get("source_clean") is True and after == source,
+        )
+        record.update(
+            state=state,
+            source_end=after,
+            elapsed_seconds=elapsed,
+            exit_status=status,
+            profiling_target=comparison,
+        )
+        write_record(output, record)
+    print(
+        f"{name}: {elapsed:.3f}s; target {work.target_seconds}; "
+        f"{comparison['status']} ({comparison['reason']}; report only). Evidence: {output}",
+        file=sys.stderr,
+    )
+    return status
+
+
+def check_validation_evidence(
+    paths: Sequence[Path], *, expected: Sequence[str], source_sha: str, run_id: str
+) -> dict[str, object]:
+    """Check one consumer-specified invocation; target misses do not invalidate evidence."""
+    from scripts.ci_qualification import require_runtime_targets
+
+    if re.fullmatch(r"[0-9a-f]{40}", source_sha) is None or not run_id:
+        raise ValueError("exact expected source and run identity are required")
+    definitions = {item.name: item.definition() for item in require_runtime_targets(expected)}
+    seen: set[str] = set()
+    comparisons: dict[str, object] = {}
+    outcomes: dict[str, object] = {}
+    fields = {
+        "format",
+        "source_sha",
+        "source_clean",
+        "run_id",
+        "definition",
+        "state",
+        "source_end",
+        "elapsed_seconds",
+        "exit_status",
+        "profiling_target",
+    }
+    for path in paths:
+        row = require_canonical_json(path.read_bytes())
+        if (
+            not isinstance(row, dict)
+            or set(row) != fields
+            or row.get("format") != "riverhog-ci-validation-timing/v1"
+        ):
+            raise ValueError("invalid validation evidence format")
+        if row.get("source_sha") != source_sha or row.get("run_id") != run_id:
+            raise ValueError("validation evidence source or run differs")
+        definition = row.get("definition")
+        if not isinstance(definition, dict):
+            raise ValueError("missing executable workload definition")
+        name = definition.get("name")
+        if not isinstance(name, str) or name not in definitions or name in seen:
+            raise ValueError("unexpected or duplicate validation workload")
+        if canonical_json_bytes(definition) != canonical_json_bytes(definitions[name]):
+            raise ValueError("validation workload, target or conditions differ")
+        if row.get("state") != "completed":
+            raise ValueError("validation execution is incomplete")
+        clean = row.get("source_clean")
+        if type(clean) is not bool or row.get("source_end") != {
+            "source_sha": source_sha,
+            "source_clean": clean,
+        }:
+            raise ValueError("validation source changed during execution")
+        comparison = validation_comparison(
+            definitions[name],
+            elapsed=row.get("elapsed_seconds"),
+            exit_status=row.get("exit_status"),
+            source_clean=clean,
+        )
+        if canonical_json_bytes(row.get("profiling_target")) != canonical_json_bytes(comparison):
+            raise ValueError("validation comparison differs from measured evidence")
+        seen.add(name)
+        comparisons[name] = comparison
+        outcomes[name] = row["exit_status"]
+    if seen != set(definitions):
+        missing = ", ".join(sorted(set(definitions) - seen))
+        raise ValueError(f"missing validation evidence: {missing}")
+    return {
+        "evidence_complete": True,
+        "functional_exit_status": outcomes,
+        "comparisons": comparisons,
+    }
+
