+from __future__ import annotations
+
+import copy
+import json
+import subprocess
+from dataclasses import replace
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from riverhog_canonical_json import canonical_json_bytes
+
+from scripts import ci_qualification as qualification
+from scripts import ci_timing as timing
+
+SOURCE = "a" * 40
+RUN = "fixed-invocation"
+
+
+def record(*, seconds=601.0, exit_status=0, clean=True):
+    definition = qualification.validation_work("stove0-scale").definition()
+    return {
+        "format": "riverhog-ci-validation-timing/v1",
+        "source_sha": SOURCE,
+        "source_clean": clean,
+        "source_end": {"source_sha": SOURCE, "source_clean": clean},
+        "run_id": RUN,
+        "definition": definition,
+        "state": "completed",
+        "elapsed_seconds": seconds,
+        "exit_status": exit_status,
+        "profiling_target": timing.validation_comparison(
+            definition, elapsed=seconds, exit_status=exit_status, source_clean=clean
+        ),
+    }
+
+
+def check(tmp_path, value, *, expected=("stove0-scale",)):
+    path = tmp_path / "evidence.json"
+    path.write_bytes(canonical_json_bytes(value))
+    return timing.check_validation_evidence(
+        [path], expected=expected, source_sha=SOURCE, run_id=RUN
+    )
+
+
+def test_work_is_derived_from_existing_qualification_choices_without_default_approvals():
+    work = {item.name: item for item in qualification.validation_workloads()}
+    assert set(qualification.REPOSITORY_TARGETS) <= work.keys()
+    assert {f"unit-{name}" for name in qualification.SHARDS} <= work.keys()
+    assert {f"image-{name}" for name in qualification.IMAGE_GROUPS} <= work.keys()
+    assert {f"compose-{name}" for name in qualification.COMPOSE_LANES} <= work.keys()
+    assert {name for name, item in work.items() if item.target_seconds is not None} == {
+        "stove0-scale"
+    }
+    with pytest.raises(ValueError, match="approval required"):
+        qualification.require_runtime_targets(["lint"])
+    with pytest.raises(ValueError, match="unknown maintained"):
+        qualification.require_runtime_targets(["unregistered-required-job"])
+
+
+def test_new_shared_work_cannot_silently_acquire_a_runtime_target(monkeypatch):
+    monkeypatch.setattr(qualification, "REPOSITORY_TARGETS", ("new-proof",))
+    assert qualification.validation_work("new-proof").command == ("make", "new-proof")
+    with pytest.raises(ValueError, match="approval required"):
+        qualification.require_runtime_targets(["new-proof"])
+
+
+@pytest.mark.parametrize("names", [(), ("lint", "lint")])
+def test_expected_qualification_set_is_nonempty_and_unique(names):
+    with pytest.raises(ValueError, match="nonempty and unique"):
+        qualification.require_runtime_targets(names)
+
+
+@pytest.mark.parametrize("target", [0, -1, float("nan"), float("inf"), True])
+def test_invalid_targets_cannot_become_permissive_budgets(target):
+    with pytest.raises(ValueError, match="positive finite"):
+        replace(qualification.validation_work("stove0-scale"), target_seconds=target)
