+def test_runner_warns_during_overrun_without_terminating_or_repeating_work(
+    tmp_path, monkeypatch, capsys
+):
+    monkeypatch.setattr(
+        timing, "source_identity", lambda _: {"source_sha": SOURCE, "source_clean": True}
+    )
+    ticks = iter([0.0, 601.0])
+    monkeypatch.setattr(timing, "time", SimpleNamespace(monotonic=lambda: next(ticks)))
+    timers, calls = [], []
+
+    class ImmediateTimer:
+        def __init__(self, seconds, callback):
+            self.seconds, self.callback, self.cancelled = seconds, callback, False
+            timers.append(self)
+
+        def start(self):
+            self.callback()
+
+        def cancel(self):
+            self.cancelled = True
+
+    def run(command, **kwargs):
+        calls.append((command, kwargs))
+        return subprocess.CompletedProcess(command, 0)
+
+    monkeypatch.setattr(timing, "Timer", ImmediateTimer)
+    monkeypatch.setattr(timing.subprocess, "run", run)
+    path = tmp_path / "run.json"
+    assert timing.execute_validation("stove0-scale", path, RUN) == 0
+    assert len(calls) == 1
+    assert calls[0][0] == qualification.validation_work("stove0-scale").command
+    assert calls[0][1]["env"]["RIVERHOG_CI_RUN_ID"] == RUN
+    assert timers[0].seconds == 600 and timers[0].cancelled
+    assert "exceeded while" in capsys.readouterr().err
+    assert json.loads(path.read_bytes())["profiling_target"]["status"] == "missed"
+    with pytest.raises(ValueError, match="overwrite"):
+        timing.execute_validation("stove0-scale", path, RUN)
+
