diff --git a/packages/retained-resource/src/retained_resource/worker.py b/packages/retained-resource/src/retained_resource/worker.py
new file mode 100644
index 00000000..f61dc2be
--- /dev/null
+++ b/packages/retained-resource/src/retained_resource/worker.py
@@ -0,0 +1,180 @@
+"""Retain a native worker exit receipt independently of Python join sentinels.
+
+This bootstrap adapter is deliberately specific to GIL-enabled CPython 3.12.
+It reuses that runtime's ordinary registration, tracing and non-daemon shutdown
+bookkeeping. Only the retained native owner establishes physical receiving.
+Service owners must explicitly join workers before interpreter finalization;
+the interpreter's shutdown sentinel does not supply a native exit receipt.
+"""
+
+from __future__ import annotations
+
+import math
+import sys
+import threading
+from collections.abc import Callable
+from time import monotonic
+from typing import Any
+
+from ._worker_native import WorkerHandle
+
+
+class WorkerBootstrapError(RuntimeError):
+    """The original native worker exited without Python acknowledgement."""
+
+
+class Worker(threading.Thread):
+    """A single native worker whose known exit survives lost Python replies.
+
+    Retain this object before start and through receiving. A pending poll keeps
+    the original work, reservations and outcome owned by the caller. Polling
+    never waits for worker execution; join is an explicitly blocking shutdown
+    convenience and propagates interruption without modifying the native receipt.
+
+    The Thread base supplies bootstrap bookkeeping, never liveness evidence.
+    This is not a general replacement for threading.Thread on other runtimes.
+    Start acknowledges native creation only; Python identity and registration
+    become available asynchronously on the original worker.
+    """
+
+    def __init__(
+        self,
+        *,
+        target: Callable[..., object],
+        args: tuple[Any, ...] = (),
+        name: str = "retained-worker",
+        daemon: bool = False,
+    ) -> None:
+        if sys.implementation.name != "cpython" or sys.version_info[:2] != (3, 12):
+            raise RuntimeError("retained worker bootstrap requires qualified CPython 3.12")
+        if daemon is not False:
+            raise ValueError("retained workers require explicit non-daemon receiving")
+        # Only fixed pending identity belongs to coordination. Thread.__init__
+        # also inserts into the global dangling WeakSet, whose pending-removal
+        # drain may visit unrelated originals. Run that initializer on the
+        # retained worker, before its ordinary runtime bootstrap instead.
+        self._name = name
+        self._ident = None
+        self._native_id = None
+        self._tstate_lock = None
+        self._started = threading.Event()
+        self._is_stopped = False
+        self._daemonic = False
+        self._initialized = True
+        self._bootstrap_spec: tuple[Callable[..., object], tuple[Any, ...]] | None = (
+            target,
+            args,
+        )
+        # The native constructor has no worker effect. Retention precedes start.
+        self._exit_owner = WorkerHandle(self._bootstrap_owned)
+
+    @property
+    def daemon(self) -> bool:
+        return False
+
+    @daemon.setter
+    def daemon(self, value: bool) -> None:
+        if value is not False:
+            raise ValueError("retained workers require explicit non-daemon receiving")
+        if self.started:
+            raise RuntimeError("cannot set daemon status of a started native worker")
+        self._daemonic = False
+
+    @property
+    def started(self) -> bool:
+        return self._exit_owner.started
+
+    @property
+    def received(self) -> bool:
+        return self._exit_owner.received
+
+    @property
+    def is_current(self) -> bool:
+        return self._exit_owner.is_current
+
+    @property
+    def metrics(self) -> dict[str, int]:
+        return self._exit_owner.metrics
+
+    @property
+    def bootstrap_exception(self) -> BaseException | None:
+        """Keep unexpected bootstrap evidence separate from the work outcome."""
+        return self._exit_owner.exception
+
+    def start(self) -> None:
+        """Create the retained native worker without waiting for its bootstrap."""
+        if self.started:
+            raise RuntimeError("retained workers can only be started once")
+        # Native creation and reply uncertainty have their own retained outcome.
+        # Registry acquisition, bootstrap acknowledgement and cleanup are worker
+        # work: none may delay the coordinator's submission or unrelated polls.
+        self._exit_owner.start()
+
+    def _bootstrap_owned(self) -> None:
+        # Run only on the original native worker. The slot and native self-pin
+        # already retain it, even while the runtime registry lock is occupied.
+        # The pinned bootstrap still establishes the normal Thread identity,
+        # tracing/profile hooks and non-daemon shutdown sentinel before user work.
+        try:
+            spec = self._bootstrap_spec
+            assert spec is not None
+            acknowledgement = self._started
+            try:
+                super().__init__(target=spec[0], args=spec[1], name=self._name, daemon=False)
+            finally:
+                # Preserve the fixed pending flag even if initialization fails.
+                # Its observation becomes final only after native receiving.
+                self._started = acknowledgement
+            self._bootstrap_spec = None
+            del spec
+            with threading._active_limbo_lock:  # type: ignore[attr-defined]
+                threading._limbo[self] = self  # type: ignore[attr-defined]
+            self._bootstrap()  # type: ignore[attr-defined]
+        finally:
+            # An exception before normal active registration must not leave a
+            # limbo reference. Cleanup may wait only on this original worker;
+            # a successful native exit receipt includes its completion.
+            with threading._active_limbo_lock:  # type: ignore[attr-defined]
+                if threading._limbo.get(self) is self:  # type: ignore[attr-defined]
+                    del threading._limbo[self]  # type: ignore[attr-defined]
+
+    def _delete(self) -> None:
+        # CPython calls this even when bootstrap fails before active insertion.
+        # Exact-owner removal preserves the original exception instead of
+        # replacing it with a missing-entry KeyError or removing another owner.
+        ident = threading.get_ident()
+        with threading._active_limbo_lock:  # type: ignore[attr-defined]
+            if threading._active.get(ident) is self:  # type: ignore[attr-defined]
+                del threading._active[ident]  # type: ignore[attr-defined]
+
+    def poll(self) -> bool:
+        """Receive the original native exit with at most one zero-wait probe."""
+        received = self._exit_owner.poll()
+        # Only native receiving makes bootstrap evidence final. This is one
+        # nonwaiting flag observation, never an acknowledgement wait or receipt.
+        if received and self.started and not self._started.is_set():
+            raise WorkerBootstrapError(
+                "original worker bootstrap exited before acknowledgement"
+            ) from (self.bootstrap_exception)
+        return received
+
+    def is_alive(self) -> bool:
+        # Do not call Thread.is_alive/_wait_for_tstate_lock on this object.
+        return self.started and (self.is_current or not self.poll())
+
+    def join(self, timeout: float | None = None) -> None:
+        if not self.started:
+            raise RuntimeError("cannot join a retained worker before native start")
+        if self.is_current:
+            raise RuntimeError("cannot join the current retained worker")
+        if timeout is not None and not math.isfinite(timeout):
+            raise ValueError("retained worker timeout must be finite")
+        deadline = None if timeout is None else monotonic() + max(0.0, timeout)
+        wake = threading.Event()
+        while not self.poll():
+            remaining = None if deadline is None else deadline - monotonic()
+            if remaining is not None and remaining <= 0:
+                return
+            # This wait carries no exit authority. Signals can interrupt it while
+            # the native handle and its recorded receiving outcome stay intact.
+            wake.wait(0.01 if remaining is None else min(0.01, remaining))
