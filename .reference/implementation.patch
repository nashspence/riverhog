index 00000000..89ba2278
--- /dev/null
+++ b/packages/retained-resource/src/retained_resource/worker_growth.py
@@ -0,0 +1,149 @@
+"""Actual native and caller-owned wrapper work for one worker control call."""
+
+from collections.abc import Callable
+
+from riverhog_growth_contracts import (
+    COUNT,
+    Bound,
+    Declaration,
+    Dimension,
+    Expression,
+    declare_growth,
+)
+
+from ._worker_native import WorkerHandle
+from .worker import Worker
+
+
+def declaration(operation: str) -> Declaration:
+    starting = operation == "start"
+    limits = {
+        "start_calls": 1 if starting else 0,
+        "poll_calls": 0 if starting else 1,
+        "join_calls": 0 if starting else 1,
+        "wait_calls": 0 if starting else 1,
+        "close_calls": 0 if starting else 1,
+        "exit_receipts": 0 if starting else 1,
+    }
+    return Declaration(
+        id=f"retained-resource.worker-{operation}.growth/v1",
+        authority="retained-resource",
+        subjects=(f"retained_resource.worker_growth.{operation}",),
+        scope="one operation on the exact retained native worker owner",
+        starts_at="caller has retained original worker ownership and capacity",
+        ends_at="recorded native outcome or conservative pending/unknown observation",
+        dimensions=(
+            Dimension("unrelated_workers", COUNT, "Unrelated retained originals, never scanned."),
+        ),
+        bounds=tuple(
+            Bound(
+                name,
+                COUNT,
+                "upper",
+                Expression("constant", value=limit, unit=COUNT),
+                "Actual native API entries or recorded positive OS exit outcomes.",
+            )
+            for name, limit in limits.items()
+        ),
+        conditions=(
+            "GIL-enabled main-interpreter CPython with the admitted native backend.",
+            "Linux joinable pthreads or Windows dynamic-UCRT thread HANDLEs.",
+            "The owner stays in its original process through explicit receiving.",
+        ),
+        invariants=(
+            "Each original admits at most one native worker creation.",
+            "Each original records at most one positive OS exit receipt.",
+            "A received original performs no more joins, waits or handle closes.",
+            "A Future, target return, Python sentinel or thread ID is not an exit receipt.",
+            "Pending probes remain nonblocking and never enumerate unrelated originals.",
+        ),
+        limitations=(
+            "Native API entries do not bound internal scheduler or allocator latency.",
+            "Callback work, Python bootstrap and thread-local finalization are separate scopes.",
+            "No aggregate process memory or wall-clock performance claim.",
+        ),
+    )
+
+
+@declare_growth(declaration("start"))
+def start(owner: WorkerHandle) -> None:
+    owner.start()
+
+
+@declare_growth(declaration("poll"))
+def poll(owner: WorkerHandle) -> bool:
+    return owner.poll()
+
+
+def coordination_declaration(operation: str) -> Declaration:
+    if operation not in {"construct_worker", "start_worker", "poll_worker"}:
+        raise ValueError("worker coordination operation is not declared")
+    starting = operation == "start_worker"
+    polling = operation == "poll_worker"
+    limits = {
+        "start_calls": 1 if starting else 0,
+        "poll_calls": 1 if polling else 0,
+        "join_calls": 1 if polling else 0,
+        "wait_calls": 1 if polling else 0,
+        "close_calls": 1 if polling else 0,
+        "exit_receipts": 1 if polling else 0,
+        "coordinator_wait_calls": 0,
+        "coordinator_registry_acquires": 0,
+        "coordinator_registry_steps": 0,
+        "coordinator_registry_enumerations": 0,
+        "coordinator_weakref_retirements": 0,
+        "coordinator_weakref_cleanup_steps": 0,
+        "acknowledgement_probes": 1 if polling else 0,
+    }
+    return Declaration(
+        id=f"retained-resource.{operation.replace('_', '-')}.growth/v1",
+        authority="retained-resource",
+        subjects=(f"retained_resource.worker_growth.{operation}",),
+        scope="one public worker construction, start or nonwaiting receive on the coordinator",
+        starts_at="worker identity admission or original-owner retention before native effects",
+        ends_at="recorded native outcome or bounded final-bootstrap diagnosis",
+        dimensions=(
+            Dimension("unrelated_workers", COUNT, "Unrelated retained originals, never scanned."),
+        ),
+        bounds=tuple(
+            Bound(
+                name,
+                COUNT,
+                "equal" if limit == 0 else "upper",
+                Expression("constant", value=limit, unit=COUNT),
+                "Actual native entries and coordinator flag, wait or registry operations.",
+            )
+            for name, limit in limits.items()
+        ),
+        conditions=(
+            "The admitted GIL-enabled CPython bootstrap adapter and native backend.",
+            "One startup coordinator retains the worker before its native creation.",
+        ),
+        invariants=(
+            "Startup acknowledges native creation, not Python bootstrap completion.",
+            "Construction retains fixed pending identity; registration belongs to the worker.",
+            "No acknowledgement wait or bootstrap registry operation belongs to coordination.",
+            "Native receiving precedes the single final-bootstrap flag observation.",
+            "Failed bootstrap retains its original diagnosis; no semantic result is invented.",
+        ),
+        limitations=(
+            "Worker-owned bootstrap, cleanup, callbacks and thread-local destruction may wait.",
+            "Native API entries do not bound internal scheduler or allocator latency.",
+            "Explicit blocking shutdown joins have a separate execution-owned lifetime.",
+        ),
+    )
+
+
+@declare_growth(coordination_declaration("construct_worker"))
+def construct_worker(target: Callable[[], object]) -> Worker:
+    return Worker(target=target)
+
+
+@declare_growth(coordination_declaration("start_worker"))
+def start_worker(owner: Worker) -> None:
+    owner.start()
+
+
+@declare_growth(coordination_declaration("poll_worker"))
+def poll_worker(owner: Worker) -> bool:
+    return owner.poll()
