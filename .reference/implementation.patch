@@ -0,0 +1,347 @@
+"""Isolated ownership and coordination witnesses around actual native bootstrap."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import signal
+import sys
+import threading
+from pathlib import Path
+from time import monotonic, sleep
+
+from riverhog_core.archive_execution_tuning import ArchiveExecutionTuning
+
+from tests.support.physical_exit_probe import await_native_exit, load_source
+
+
+def select_source(implementation, worker):
+    source = load_source(implementation)
+    if worker is not None:
+        spec = importlib.util.spec_from_file_location(
+            "retained_resource._bootstrap_probe_original", worker
+        )
+        assert spec is not None and spec.loader is not None
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        source.Worker = module.Worker
+    return source
+
+
+def receive_native(worker):
+    """Explicitly receive native exit even when bootstrap diagnostics remain."""
+    deadline = monotonic() + 10
+    while not worker._exit_owner.poll():
+        assert monotonic() < deadline, "original native bootstrap worker did not exit"
+        sleep(0.001)
+
+
+def exercise(*, mode, kind, implementation=None, worker=None):
+    source = select_source(implementation, worker)
+    actual_worker = source.Worker
+    module = sys.modules[actual_worker.__module__]
+    native_factory = module.WorkerHandle
+    entered, release, submitted = threading.Event(), threading.Event(), threading.Event()
+    native_ids, submit_outcomes, calls = [], [], []
+    original, ready_value, fresh_value = object(), object(), object()
+    original_identity, ready_identity, fresh_identity = object(), object(), object()
+    receiver, ready_receiver, fresh_receiver = object(), object(), object()
+    failure = RuntimeError("original bootstrap failed before acknowledgement")
+    terminal = kind == "workspace"
+    pool = source.PhysicalExecutionOwner(
+        ArchiveExecutionTuning(
+            forward_workers=3,
+            forward_workers_per_target=3,
+            terminal_workers=3,
+            terminal_workers_per_target=3,
+        )
+    )
+
+    def original_work():
+        calls.append(original_identity)
+        return original
+
+    class ControlledBootstrap(actual_worker):
+        def __init__(self, **arguments):
+            self.held_original = arguments["args"][0] is original_work
+            super().__init__(**arguments)
+
+        def _bootstrap(self):
+            if self.held_original:
+                native_ids.append(threading.get_native_id())
+                entered.set()
+                if mode == "failure":
+                    raise failure
+                assert release.wait(15), "original bootstrap was not explicitly released"
+            return super()._bootstrap()
+
+    class InterruptedStart:
+        def __init__(self, original_handle):
+            self.original = original_handle
+
+        def start(self):
+            self.original.start()
+            # The real native owner has created and recorded the original.
+            # Deliver an actual signal before its Python startup reply returns.
+            signal.raise_signal(signal.SIGINT)
+
+        def __getattr__(self, name):
+            return getattr(self.original, name)
+
+    def create_native(target):
+        handle = native_factory(target)
+        if getattr(target.__self__, "held_original", False):
+            return InterruptedStart(handle)
+        return handle
+
+    def key(number):
+        if terminal:
+            return source.PhysicalWorkspaceExecutionKey(f"{number:032x}", "a" * 64)
+        return source.PhysicalExecutionKey(number, "a" * 64)
+
+    def submit(number, callback, owner, identity):
+        arguments = dict(target_incarnation="local", work=callback, owner=owner, identity=identity)
+        if terminal:
+            return pool.try_submit_workspace(key(number), **arguments)
+        return pool.try_submit(key(number), terminal=False, **arguments)
+
+    def collect(owner):
+        if terminal:
+            return pool.collect_workspace(limit=1, owner=owner)
+        return pool.collect(limit=1, owner=owner)
+
+    def coordinator():
+        try:
+            submit_outcomes.append(submit(2, original_work, receiver, original_identity))
+        except BaseException as error:
+            submit_outcomes.append(error)
+        finally:
+            submitted.set()
+
+    report = {"mode": mode, "kind": kind}
+    submitting = None
+    closing = None
+    late_release = threading.Event()
+    diagnosed = []
+    try:
+        assert submit(1, lambda: ready_value, ready_receiver, ready_identity) == "submitted"
+        ready = pool._slots[key(1)]
+        ready.worker.join(timeout=5)
+        assert ready.worker.received and ready.future.done()
+        source.Worker = ControlledBootstrap
+        if mode == "interrupted":
+            module.WorkerHandle = create_native
+            coordinator()
+            assert len(submit_outcomes) == 1 and isinstance(submit_outcomes[0], KeyboardInterrupt)
+            module.WorkerHandle = native_factory
+        else:
+            submitting = threading.Thread(target=coordinator, daemon=False)
+            submitting.start()
+        assert entered.wait(5), "original native bootstrap did not enter its controlled boundary"
+        # This rendezvous is a watchdog, not a product latency target. Its gate
+        # remains held throughout every independent coordination observation.
+        returned = submitted.wait(5)
+        slot = pool._slots[key(2)]
+        report["submission_returned_before_release"] = returned
+        report["bootstrap_acknowledged_before_release"] = slot.worker._started.is_set()
+        report["original_native_creation_recorded"] = slot.worker.started
+        report["original_native_start_calls"] = slot.worker.metrics["start_calls"]
+        report["coordinator_sigint_received"] = (
+            mode == "interrupted"
+            and len(submit_outcomes) == 1
+            and isinstance(submit_outcomes[0], KeyboardInterrupt)
+        )
+        report["original_future_done_before_release"] = slot.future.done()
+        report["ready_status_before_release"] = pool.status(key(1))
+        early_ready = collect(ready_receiver)
+        report["ready_outcomes_before_release"] = len(early_ready)
+        if early_ready:
+            assert early_ready[0].result() is ready_value
+            assert early_ready[0].identity is ready_identity
+        fresh_submission = submit(3, lambda: fresh_value, fresh_receiver, fresh_identity)
+        report["fresh_submission_before_release"] = fresh_submission
+        early_fresh = ()
+        if fresh_submission == "submitted":
+            fresh = pool._slots[key(3)]
+            fresh.worker.join(timeout=5)
+            early_fresh = collect(fresh_receiver)
+            assert len(early_fresh) == 1 and early_fresh[0].result() is fresh_value
+            assert early_fresh[0].identity is fresh_identity
+        report["fresh_outcomes_before_release"] = len(early_fresh)
+        report["original_slot_retained"] = pool._slots[key(2)] is slot
+        report["original_capacity_retained"] = (
+            pool._counts[terminal] >= 1 and pool._targets[(terminal, "local")] >= 1
+        )
+
+        if mode == "failure":
+            receive_native(slot.worker)
+            assert slot.worker.bootstrap_exception is failure
+            before = slot.worker.metrics
+            for action in (
+                lambda: pool.status(key(2)),
+                lambda: collect(receiver),
+                lambda: collect(receiver),
+            ):
+                try:
+                    action()
+                except RuntimeError as error:
+                    assert error.__cause__ is failure
+                    assert "before acknowledgement" in str(error)
+                    diagnosed.append(error)
+            later_value, later_identity = object(), object()
+            later_entered, later_joined, close_returned = (
+                threading.Event(),
+                threading.Event(),
+                threading.Event(),
+            )
+            close_errors = []
+
+            def later_work():
+                later_entered.set()
+                assert late_release.wait(15), "later independent original was not released"
+                return later_value
+
+            assert submit(4, later_work, receiver, later_identity) == "submitted"
+            assert later_entered.wait(5)
+            later = pool._slots[key(4)]
+            actual_join = later.worker.join
+
+            def join_later(timeout=None):
+                later_joined.set()
+                return actual_join(timeout)
+
+            later.worker.join = join_later
+
+            def close_all():
+                try:
+                    pool.close()
+                except RuntimeError as error:
+                    assert error.__cause__ is failure
+                    close_errors.append(error)
+                finally:
+                    close_returned.set()
+
+            closing = threading.Thread(target=close_all, daemon=False)
+            closing.start()
+            drains_later = later_joined.wait(5) and not close_returned.is_set()
+            late_release.set()
+            closing.join(timeout=6)
+            assert not closing.is_alive(), "original shutdown coordinator was not received"
+            receive_native(later.worker)
+            diagnosed.extend(close_errors)
+            report["shutdown_received_later_original_before_diagnostic"] = drains_later
+            report["shutdown_reported_original_cause"] = len(close_errors) == 1
+            try:
+                collect(receiver)
+            except RuntimeError as error:
+                assert error.__cause__ is failure
+                diagnosed.append(error)
+            (later_completion,) = collect(receiver)
+            assert later_completion.result() is later_value
+            assert later_completion.identity is later_identity
+            report["same_owner_ready_outcome_received"] = True
+            after = slot.worker.metrics
+            report["original_bootstrap_diagnoses"] = len(diagnosed)
+            report["no_duplicate_native_join"] = after["join_calls"] == before["join_calls"]
+            report["semantic_future_remains_unset"] = not slot.future.done()
+            report["failed_original_remains_charged"] = (
+                pool._slots[key(2)] is slot and pool._counts[terminal] == 1
+            )
+            report["original_work_never_called"] = not calls
+            assert slot.worker.received
+        else:
+            assert not release.is_set()
+            report["native_alive_before_release"] = Path(
+                f"/proc/self/task/{native_ids[0]}"
+            ).exists()
+            assert not calls and not slot.future.done()
+            release.set()
+            if submitting is not None:
+                submitting.join(timeout=6)
+                assert not submitting.is_alive()
+            slot.worker.join(timeout=5)
+            await_native_exit(native_ids[0])
+            (completion,) = collect(receiver)
+            assert completion.result() is original and completion.identity is original_identity
+            assert calls == [original_identity]
+            if not early_ready:
+                (completion,) = collect(ready_receiver)
+                assert completion.result() is ready_value and completion.identity is ready_identity
+            assert pool._counts[terminal] == 0 and not pool._targets
+            assert collect(receiver) == ()
+            report["original_outcome_received_once"] = True
+        report["safe"] = (
+            returned
+            and not report["bootstrap_acknowledged_before_release"]
+            and not report["original_future_done_before_release"]
+            and report["ready_status_before_release"] == "awaiting-join"
+            and len(early_ready) == len(early_fresh) == 1
+            and fresh_submission == "submitted"
+            and report["original_slot_retained"]
+            and report["original_capacity_retained"]
+            and report["original_native_start_calls"] == 1
+        )
+        if mode == "failure":
+            report["safe"] = (
+                report["safe"]
+                and submit_outcomes == ["submitted"]
+                and len(diagnosed) == 5
+                and report["no_duplicate_native_join"]
+                and report["semantic_future_remains_unset"]
+                and report["failed_original_remains_charged"]
+                and report["shutdown_received_later_original_before_diagnostic"]
+                and report["shutdown_reported_original_cause"]
+            )
+        return report
+    finally:
+        release.set()
+        late_release.set()
+        module.WorkerHandle = native_factory
+        source.Worker = actual_worker
+        if submitting is not None:
+            submitting.join(timeout=6)
+            assert not submitting.is_alive(), "original submission coordinator was not received"
+        if closing is not None:
+            closing.join(timeout=6)
+            assert not closing.is_alive(), "original shutdown coordinator was not received"
+        for slot in tuple(pool._slots.values()):
+            receive_native(slot.worker)
+        if mode == "failure":
+            # Native workers are received; an unset semantic outcome remains
+            # deliberately retained with its exact original bootstrap diagnostic.
+            try:
+                pool.close()
+            except RuntimeError as error:
+                assert error.__cause__ is failure
+        else:
+            pool.close()
+        for native_id in native_ids:
+            await_native_exit(native_id)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--mode", choices=("held", "interrupted", "failure"), required=True)
+    parser.add_argument("--kind", choices=("workspace", "collection"), default="workspace")
+    parser.add_argument("--implementation", type=Path)
+    parser.add_argument("--worker", type=Path)
+    parser.add_argument("--expect", choices=("safe", "unsafe", "observe"), default="safe")
+    args = parser.parse_args()
+    if sys.platform != "linux":
+        raise RuntimeError("this original native thread witness requires Linux /proc")
+    signal.signal(signal.SIGINT, signal.default_int_handler)
+    report = exercise(
+        mode=args.mode,
+        kind=args.kind,
+        implementation=args.implementation,
+        worker=args.worker,
+    )
+    print(json.dumps(report, sort_keys=True), flush=True)
+    if args.expect != "observe":
+        assert report["safe"] is (args.expect == "safe"), report
+
+
+if __name__ == "__main__":
+    main()
