+@pytest.mark.skipif(not SUPPORTED, reason="bounded worker receiving backend")
+def test_public_bootstrap_failure_is_diagnosed_only_after_exit_and_preserves_other_owner(
+    monkeypatch,
+):
+    from retained_resource import Worker
+
+    failure = SystemExit("original bootstrap failed before acknowledgement")
+    retained = threading.current_thread()
+    observed = []
+
+    class FailedBootstrap(Worker):
+        def _set_ident(self):
+            self.failed_ident = threading.get_ident()
+            with threading._active_limbo_lock:
+                threading._active[self.failed_ident] = retained
+            raise failure
+
+    worker = FailedBootstrap(target=lambda: observed.append("unexpected callback"))
+    try:
+        with observe_worker_coordination(monkeypatch) as metrics:
+            worker.start()
+        assert metrics == dict.fromkeys(metrics, 0)
+        receive(worker._exit_owner)
+        assert worker.received and worker.bootstrap_exception is failure
+        assert not worker._started.is_set() and worker not in threading._limbo
+        assert threading._active[worker.failed_ident] is retained
+        for _ in range(3):
+            with (
+                observe_worker_coordination(monkeypatch) as metrics,
+                pytest.raises(
+                    RuntimeError, match="bootstrap exited before acknowledgement"
+                ) as error,
+            ):
+                worker.poll()
+            assert error.value.__cause__ is failure
+            assert metrics == {name: int(name == "acknowledgement_probes") for name in metrics}
+        assert observed == [] and worker.metrics["exit_receipts"] == 1
+    finally:
+        if hasattr(worker, "failed_ident"):
+            with threading._active_limbo_lock:
+                if threading._active.get(worker.failed_ident) is retained:
+                    del threading._active[worker.failed_ident]
+
+
+def test_received_exception_cycle_can_release_after_original_receiving(worker_native):
+    class Callback:
+        def __call__(self):
+            raise RuntimeError("original exception retaining callback frame")
+
+    callback = Callback()
+    worker = worker_native.WorkerHandle(callback)
+    callback.owner = worker
+    reference = weakref.ref(callback)
+    worker.start()
+    receive(worker)
+    assert isinstance(worker.exception, RuntimeError)
+    del callback, worker
+    gc.collect()
+    assert reference() is None
+
