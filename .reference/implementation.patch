+def test_worker_owned_registry_failure_preserves_original_diagnostic_and_slot(monkeypatch):
+    created = []
+    failure = KeyboardInterrupt("bootstrap registration reply interrupted")
+
+    class OriginalWorker(source.Worker):
+        def __init__(self, **arguments):
+            super().__init__(**arguments)
+            created.append(self)
+
+    class LostRegistrationReply:
+        def __init__(self, actual):
+            self.actual = actual
+
+        def __setitem__(self, key, value):
+            self.actual[key] = value
+            if isinstance(key, OriginalWorker):
+                raise failure
+
+        def __delitem__(self, key):
+            del self.actual[key]
+
+        def get(self, key, default=None):
+            return self.actual.get(key, default)
+
+        def __contains__(self, key):
+            return key in self.actual
+
+    pool = PhysicalExecutionOwner(ArchiveExecutionTuning())
+    registry = LostRegistrationReply(threading._limbo)
+    with monkeypatch.context() as patch:
+        patch.setattr(source, "Worker", OriginalWorker)
+        patch.setattr(threading, "_limbo", registry)
+        assert (
+            _submit(pool, 1, lambda: pytest.fail("failed bootstrap dispatched work")) == "submitted"
+        )
+        slot = pool._slots[_key()]
+        deadline = monotonic() + 5
+        while not slot.worker._exit_owner.poll():
+            assert monotonic() < deadline
+            sleep(0.001)
+        assert len(created) == 1 and created[0] not in registry
+        assert created[0].started and created[0].received
+        assert created[0].bootstrap_exception is failure
+        for action in (
+            lambda: pool.status(_key()),
+            lambda: pool.collect(limit=1, owner=None),
+            pool.close,
+        ):
+            with pytest.raises(RuntimeError, match="before acknowledgement") as observed:
+                action()
+            assert observed.value.__cause__ is failure
+        assert pool._slots[_key()] is slot and not slot.future.done()
+        assert pool._counts[False] == pool._targets[(False, "target-a")] == 1
