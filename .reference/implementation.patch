@@ -0,0 +1,301 @@
+"""Isolated real-signal observations of the original physical worker's exit."""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import os
+import signal
+import sys
+import threading
+from pathlib import Path
+from time import monotonic, sleep
+
+
+def interrupt_close(pool, worker):
+    """Deliver SIGINT only after the coordinator entered its actual join frame."""
+    coordinator = threading.get_ident()
+    actual_join = worker.join
+    # On the old implementation, observe the actual blocking sentinel acquire.
+    # The retained implementation owns its wait in the public Worker.join frame.
+    if isinstance(worker, threading.Thread) and not hasattr(worker, "poll"):
+        waiting_code = threading.Thread._wait_for_tstate_lock.__code__
+    else:
+        waiting_code = actual_join.__func__.__code__
+    delivered = threading.Event()
+    stopped = threading.Event()
+    errors = []
+
+    def send():
+        deadline = monotonic() + 5
+        while not stopped.is_set() and monotonic() < deadline:
+            frame = sys._current_frames().get(coordinator)
+            while frame is not None:
+                if frame.f_code is waiting_code:
+                    delivered.set()
+                    os.kill(os.getpid(), signal.SIGINT)
+                    return
+                frame = frame.f_back
+            sleep(0.001)
+        if not stopped.is_set():
+            errors.append("coordinator never entered the original worker join")
+            os.kill(os.getpid(), signal.SIGINT)
+
+    sender = threading.Thread(target=send, name="physical-exit-signal", daemon=False)
+    sender.start()
+    interrupted = False
+    try:
+        try:
+            pool.close()
+        except KeyboardInterrupt:
+            interrupted = True
+    finally:
+        stopped.set()
+        sender.join(timeout=6)
+    assert not sender.is_alive(), "original signal sender was not received"
+    assert not errors, errors
+    assert delivered.is_set() and interrupted, "actual coordinator join was not interrupted"
+    return interrupted
+
+
+def await_native_exit(native_id):
+    """Independent Linux test evidence, never a product receiving primitive."""
+    path = Path(f"/proc/self/task/{native_id}")
+    deadline = monotonic() + 10
+    while path.exists() and monotonic() < deadline:
+        sleep(0.001)
+    assert not path.exists(), "original native worker failed to exit after explicit release"
+
+
+def load_source(path):
+    if path is None:
+        from riverhog_core.services import physical_execution
+
+        return physical_execution
+    spec = importlib.util.spec_from_file_location("_physical_exit_probe_owner", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def exercise(*, kind, tail, outcome, implementation=None, lease_root=None):
+    from contextlib import nullcontext
+
+    from riverhog_core.archive_execution_tuning import ArchiveExecutionTuning
+
+    from tests.support.validation_workspace import leased_workspace
+
+    source = load_source(implementation)
+    terminal = kind == "workspace"
+    tuning = ArchiveExecutionTuning(
+        forward_workers=2,
+        forward_workers_per_target=1,
+        terminal_workers=2,
+        terminal_workers_per_target=1,
+    )
+    pool = source.PhysicalExecutionOwner(tuning)
+    receiver, identity, value = object(), object(), object()
+    failure = RuntimeError("original physical execution diagnostic")
+    entered, release = threading.Event(), threading.Event()
+    local = threading.local()
+    native_ids, finalizer_failures = [], []
+    calls = []
+
+    def original_lease():
+        if lease_root is None:
+            return nullcontext()
+        return leased_workspace(lease_root, "d" * 32, create=True)
+
+    def lease_available():
+        if lease_root is None:
+            return None
+        with leased_workspace(lease_root, "d" * 32, shared=True) as directory:
+            return directory is not None
+
+    class Finalizer:
+        def __init__(self, lease):
+            self.lease = lease
+
+        def __del__(self):
+            try:
+                entered.set()
+                if not release.wait(15):
+                    finalizer_failures.append("original thread-local finalization timed out")
+            finally:
+                try:
+                    self.lease.__exit__(None, None, None)
+                except BaseException as error:
+                    finalizer_failures.append(type(error).__name__)
+
+    def work():
+        calls.append(identity)
+        native_ids.append(threading.get_native_id())
+        if tail == "thread-local":
+            lease = original_lease()
+            lease.__enter__()
+            local.original = Finalizer(lease)
+        if outcome == "failure":
+            raise failure
+        return value
+
+    actual_run = source._run
+
+    def held_run(callback, future):
+        if callback is work and tail == "target":
+            with original_lease():
+                actual_run(callback, future)
+                entered.set()
+                assert release.wait(15), "original worker tail was not released"
+        else:
+            actual_run(callback, future)
+
+    source._run = held_run
+
+    def key(number):
+        if terminal:
+            return source.PhysicalWorkspaceExecutionKey(f"{number:032x}", "a" * 64)
+        return source.PhysicalExecutionKey(number, "a" * 64)
+
+    def submit(number, callback, *, target="original", original=identity):
+        arguments = dict(
+            target_incarnation=target, work=callback, owner=receiver, identity=original
+        )
+        if terminal:
+            return pool.try_submit_workspace(key(number), **arguments)
+        return pool.try_submit(key(number), terminal=False, **arguments)
+
+    def collect(owner=receiver):
+        if terminal:
+            return pool.collect_workspace(limit=1, owner=owner)
+        return pool.collect(limit=1, owner=owner)
+
+    report = {"kind": kind, "tail": tail, "outcome": outcome}
+    early = ()
+    try:
+        assert submit(1, work) == "submitted"
+        assert entered.wait(5), "original post-publication tail was not entered"
+        slot = pool._slots[key(1)]
+        native_id = native_ids[0]
+        assert Path(f"/proc/self/task/{native_id}").exists()
+        assert slot.future.done()
+        if lease_root is not None:
+            assert not lease_available(), "original native worker released its active lease"
+        assert submit(1, lambda: None) == "retained"
+        assert submit(2, lambda: None) == "target-capacity"
+        try:
+            submit(1, lambda: None, original=object())
+        except source.PhysicalExecutionOccupied:
+            pass
+        else:
+            raise AssertionError("another invocation adopted the original physical worker")
+        assert collect(object()) == ()
+        assert submit(2, lambda: "independent", target="independent") == "submitted"
+        assert submit(3, lambda: None, target="third") == "capacity"
+        independent = pool._slots[key(2)]
+        independent.worker.join(timeout=5)
+        assert not independent.worker.is_alive()
+        assert collect() == ()
+        (completed,) = collect()
+        assert completed.result() == "independent" and completed.key == key(2)
+        assert pool._counts[terminal] == 1
+        report["independent_received_while_original_held"] = True
+
+        interrupt_close(pool, slot.worker)
+        report["coordinator_interruptions"] = 1
+        report["future_done"] = slot.future.done()
+        report["native_alive_after_interrupt"] = Path(f"/proc/self/task/{native_id}").exists()
+        report["worker_reports_alive_after_interrupt"] = slot.worker.is_alive()
+        report["tail_held_after_interrupt"] = not release.is_set()
+        report["status_after_interrupt"] = pool.status(key(1))
+        early = collect()
+        report["outcomes_before_exit"] = len(early)
+        report["capacity_before_exit"] = pool._counts[terminal]
+        report["target_capacity_before_exit"] = pool._targets.get((terminal, "original"), 0)
+        report["original_slot_retained"] = pool._slots.get(key(1)) is slot
+        report["foreign_receiver_empty"] = collect(object()) == ()
+        report["shared_lease_available_before_exit"] = lease_available()
+        if lease_root is not None:
+            assert report["shared_lease_available_before_exit"] is False
+        if not early:
+            interrupt_close(pool, slot.worker)
+            report["coordinator_interruptions"] += 1
+            assert collect() == ()
+            assert pool._slots[key(1)] is slot and pool._counts[terminal] == 1
+
+        release.set()
+        pool.close()
+        await_native_exit(native_id)
+        report["shared_lease_available_after_exit"] = lease_available()
+        if lease_root is not None:
+            assert report["shared_lease_available_after_exit"] is True
+        late = collect()
+        report["outcomes_after_exit"] = len(late)
+        (original,) = early + late
+        assert original.key == key(1)
+        assert original.owner is receiver and original.identity is identity
+        assert original.target_incarnation == "original" and original.terminal is terminal
+        if outcome == "failure":
+            try:
