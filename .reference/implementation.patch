@@ -0,0 +1,443 @@
+"""Original native worker outcomes survive interruption and receiving retries."""
+
+from __future__ import annotations
+
+import gc
+import importlib.util
+import subprocess
+import sys
+import threading
+import time
+import weakref
+from pathlib import Path
+
+import pytest
+
+SUPPORTED = sys.platform in {"linux", "win32"}
+
+
+@pytest.fixture(scope="session")
+def worker_native():
+    if not SUPPORTED:
+        pytest.skip("bounded worker receiving backend is Linux or Windows")
+    from retained_resource import _worker_native
+
+    return _worker_native
+
+
+@pytest.fixture(scope="session")
+def fault_worker_native(tmp_path_factory):
+    if not SUPPORTED:
+        pytest.skip("bounded worker receiving backend is Linux or Windows")
+    from setuptools import Distribution, Extension
+    from setuptools.command.build_ext import build_ext
+
+    package = Path(__file__).resolve().parents[1]
+    output = tmp_path_factory.mktemp("retained-worker-fault-native")
+    extension = Extension(
+        "_retained_worker_test._worker_native",
+        sources=[str(package / "native/worker.c")],
+        define_macros=[("RETAINED_RESOURCE_TESTING", "1")],
+        extra_compile_args=(
+            ["/std:c11", "/W4"]
+            if sys.platform == "win32"
+            else ["-std=c11", "-Wall", "-Wextra", "-Werror", "-pthread"]
+        ),
+        extra_link_args=[] if sys.platform == "win32" else ["-pthread"],
+    )
+    command = build_ext(Distribution({"ext_modules": [extension]}))
+    command.build_lib = str(output)
+    command.build_temp = str(output / "build")
+    command.ensure_finalized()
+    command.run()
+    path = Path(command.get_ext_fullpath(extension.name))
+    spec = importlib.util.spec_from_file_location(extension.name, path)
+    assert spec is not None and spec.loader is not None
+    native = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(native)
+    return native
+
+
+def receive(worker):
+    deadline = time.monotonic() + 10
+    while not worker.poll():
+        assert time.monotonic() < deadline, "original native worker did not exit"
+        threading.Event().wait(0.001)
+    assert worker.received
+    assert worker.metrics["retained_native_owners"] == 0
+
+
+def test_normal_build_has_no_worker_fault_seam(worker_native):
+    worker = worker_native.WorkerHandle(lambda: None)
+    assert not hasattr(worker, "_test_fault")
+    assert not hasattr(worker, "_test_native_tail")
+    assert not hasattr(worker, "_test_native_tail_state")
+    assert not worker.started and not worker.received and not worker.poll()
+    assert worker.native_id is None and not worker.is_current
+    assert all(
+        worker.metrics[name] == 0
+        for name in ("start_calls", "join_calls", "wait_calls", "close_calls")
+    )
+    with pytest.raises(TypeError, match="callable"):
+        worker_native.WorkerHandle(None)
+
+
+def test_one_original_start_and_one_sticky_exit_receipt(worker_native):
+    calls = []
+    worker = worker_native.WorkerHandle(lambda: calls.append("original"))
+    worker.start()
+    with pytest.raises(RuntimeError, match="single-attempt"):
+        worker.start()
+    receive(worker)
+    assert calls == ["original"] and worker.started and worker.exception is None
+    before = worker.metrics
+    for _ in range(17):
+        assert worker.poll()
+    after = worker.metrics
+    assert after["start_calls"] == 1
+    assert after["poll_calls"] - before["poll_calls"] == 17
+    assert all(after[name] == before[name] for name in ("join_calls", "wait_calls", "close_calls"))
+
+
+def test_original_callback_exception_remains_owned(worker_native):
+    failure = SystemExit("original callback exception")
+
+    def failed():
+        raise failure
+
+    worker = worker_native.WorkerHandle(failed)
+    worker.start()
+    receive(worker)
+    assert worker.exception is failure
+    assert worker.poll() and worker.exception is failure
+
+
+def test_current_worker_cannot_receive_itself(worker_native):
+    observed = []
+
+    def running():
+        observed.append(worker.is_current)
+        with pytest.raises(RuntimeError, match="current native worker"):
+            worker.poll()
+
+    worker = worker_native.WorkerHandle(running)
+    worker.start()
+    receive(worker)
+    assert worker.exception is None and observed == [True] and not worker.is_current
+
+
+def test_receiving_waits_for_original_thread_local_finalization(worker_native):
+    local = threading.local()
+    finalized, release = threading.Event(), threading.Event()
+    finished = []
+
+    class Tail:
+        def __del__(self):
+            finalized.set()
+            if release.wait(10):
+                finished.append("original TLS")
+
+    def work():
+        local.original = Tail()
+
+    worker = worker_native.WorkerHandle(work)
+    worker.start()
+    try:
+        assert finalized.wait(5)
+        assert worker.started and worker.native_id is not None
+        if sys.platform == "linux":
+            assert Path(f"/proc/self/task/{worker.native_id}").exists()
+        for _ in range(17):
+            assert not worker.poll() and not worker.received
+        assert worker.metrics["retained_native_owners"] == 1
+    finally:
+        release.set()
+        receive(worker)
+    assert finished == ["original TLS"] and worker.exception is None
+
+
+@pytest.mark.skipif(sys.platform != "linux", reason="Linux native TLS destructor seam")
+def test_receiving_waits_past_python_cleanup_for_native_tls(fault_worker_native):
+    worker = fault_worker_native.WorkerHandle(lambda: None)
+    worker._test_native_tail("hold")
+    worker.start()
