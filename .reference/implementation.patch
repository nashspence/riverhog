+"""Real coordinator interruption at the maintained workspace retirement boundary."""
+
+from __future__ import annotations
+
+import json
+import signal
+import sys
+import threading
+from datetime import timedelta
+from pathlib import Path
+
+from riverhog_core.archive_execution_tuning import ArchiveExecutionTuning
+from riverhog_core.services import physical_execution as physical
+from riverhog_core.services.archive_construction_retention import ArchiveConstructionRetention
+from riverhog_core.services.upload_journal_validation_retirement import (
+    UploadJournalValidationRetirement,
+)
+
+from tests.support.physical_exit_probe import await_native_exit, interrupt_close
+from tests.unit.test_journal_retirement_registry import native_case
+from tests.unit.test_journal_validation_retirement import ONE, selected
+
+
+def exercise(root):
+    with native_case(root) as case:
+        pool = physical.PhysicalExecutionOwner(ArchiveExecutionTuning(terminal_workers=1))
+        ledger = ArchiveConstructionRetention(pool._tuning)
+        cleanup = UploadJournalValidationRetirement(
+            case.factory,
+            case.root,
+            execution=pool,
+            retention=ledger,
+            metadata_budget=1024 * 1024,
+            receive_limit=16,
+            retry_after=timedelta(microseconds=1),
+        )
+        registry = cleanup._registry
+        entered, release = threading.Event(), threading.Event()
+        actual_run = physical._run
+        native_ids = []
+
+        def held_run(work, future):
+            native_ids.append(threading.get_native_id())
+            actual_run(work, future)
+            entered.set()
+            assert release.wait(15), "original retirement worker was not released"
+
+        physical._run = held_run
+        try:
+            assert cleanup.advance(octet_budget=17) == 1 and entered.wait(5)
+            context = registry._contexts[ONE]
+            slot = pool._slots[context.reservation.key]
+            assert context.actor.received and slot.future.done()
+            assert selected(case.factory, ONE).state == "directory"
+            assert not case.files[ONE].exists() and (case.root / ONE / ".lease").exists()
+            assert cleanup.advance(octet_budget=17) == 0
+            assert ledger._counts[False] == 1 and registry.collect(limit=1) == 0
+            for _ in range(2):
+                interrupt_close(pool, slot.worker)
+                assert Path(f"/proc/self/task/{native_ids[0]}").exists()
+                assert registry.collect(limit=1) == 0
+                assert pool._slots[context.reservation.key] is slot
+                assert pool._counts[True] == 1 and ledger._counts[False] == 1
+                assert registry._contexts[ONE] is context and not context.received
+                assert selected(case.factory, ONE).state == "directory"
+                assert (case.root / ONE / ".lease").exists()
+            cleanup.close()
+            assert not cleanup.receive_stopped()
+            assert context.original is context.actor and registry.retained(ONE)
+            release.set()
+            pool.close()
+            await_native_exit(native_ids[0])
+            assert registry.collect(limit=1) == 2
+            assert context.received and context.closed and context.progress is True
+            assert not registry.retained(ONE) and ledger._counts == {False: 0, True: 0}
+            assert cleanup.receive_stopped()
+            assert selected(case.factory, ONE).state == "directory"
+            assert (case.root / ONE / ".lease").exists()
+            return {
+                "coordinator_interruptions": 2,
+                "native_alive_while_held": True,
+                "original_context_retained_until_exit": True,
+                "physical_and_construction_capacity_retained": True,
+                "lease_namespace_retained": True,
+                "directory_phase_not_dispatched": True,
+                "original_progress_received_once": True,
+                "stopped_receiving_after_exit": True,
+            }
+        finally:
+            release.set()
+            physical._run = actual_run
+            pool.close()
+            if native_ids:
+                await_native_exit(native_ids[0])
+            cleanup.close()
+            assert cleanup.receive_stopped()
+
+
+if __name__ == "__main__":
+    if sys.platform != "linux":
+        raise RuntimeError("this native-thread identity witness requires Linux /proc")
+    signal.signal(signal.SIGINT, signal.default_int_handler)
+    print(json.dumps(exercise(Path(sys.argv[1])), sort_keys=True), flush=True)
