+        else:
+            assert original.result() is value
+        assert calls == [identity]
+        assert collect() == ()
+        pool.close()
+        assert pool._counts[terminal] == 0 and not pool._targets
+        assert not finalizer_failures, finalizer_failures
+        report["exact_original_outcome_received"] = True
