@@ -0,0 +1,219 @@
+"""Observe caller-owned worker wrapper primitives without delaying real workers."""
+
+from __future__ import annotations
+
+import threading
+import time
+from collections.abc import MutableMapping
+from contextlib import contextmanager
+
+COORDINATION_METRICS = (
+    "coordinator_wait_calls",
+    "coordinator_registry_acquires",
+    "coordinator_registry_steps",
+    "coordinator_registry_enumerations",
+    "coordinator_weakref_retirements",
+    "coordinator_weakref_cleanup_steps",
+    "acknowledgement_probes",
+)
+
+
+@contextmanager
+def observe_worker_coordination(monkeypatch):
+    """Count actual calling-thread operations, not worker-owned bootstrap work.
+
+    Forbidden waits and registry acquisitions fail at their actual entry so a
+    regression cannot deadlock the test behind an intentionally held bootstrap.
+    Mapping proxies forward to original dictionaries; no registrations are copied
+    or lost when the observation ends while a real worker is still running.
+    Weak-reference callbacks retire their own registry entry by one direct set
+    discard or pending-list append; draining the pending list is separate work.
+    """
+    from retained_resource import Worker
+
+    caller = threading.get_ident()
+    metrics = dict.fromkeys(COORDINATION_METRICS, 0)
+
+    def record(name):
+        if threading.get_ident() == caller:
+            metrics[name] += 1
+            return True
+        return False
+
+    def forbidden_wait(actual):
+        def observed(*args, **kwargs):
+            if record("coordinator_wait_calls"):
+                raise AssertionError("worker coordination entered a waiting primitive")
+            return actual(*args, **kwargs)
+
+        return observed
+
+    class RegistryLock:
+        def __init__(self, actual):
+            self.actual = actual
+
+        def acquire(self, *args, **kwargs):
+            if record("coordinator_registry_acquires"):
+                raise AssertionError("worker coordination acquired a bootstrap registry lock")
+            return self.actual.acquire(*args, **kwargs)
+
+        def release(self):
+            return self.actual.release()
+
+        def __enter__(self):
+            self.acquire()
+            return self
+
+        def __exit__(self, *_args):
+            self.release()
+
+        def __getattr__(self, name):
+            return getattr(self.actual, name)
+
+    class Registry(MutableMapping):
+        def __init__(self, actual):
+            self.actual = actual
+
+        def __getitem__(self, key):
+            record("coordinator_registry_steps")
+            return self.actual[key]
+
+        def __setitem__(self, key, value):
+            record("coordinator_registry_steps")
+            self.actual[key] = value
+
+        def __delitem__(self, key):
+            record("coordinator_registry_steps")
+            del self.actual[key]
+
+        def __contains__(self, key):
+            record("coordinator_registry_steps")
+            return key in self.actual
+
+        def __len__(self):
+            record("coordinator_registry_steps")
+            return len(self.actual)
+
+        def __iter__(self):
+            record("coordinator_registry_enumerations")
+            return iter(self.actual)
+
+        def get(self, key, default=None):
+            record("coordinator_registry_steps")
+            return self.actual.get(key, default)
+
+        def pop(self, key, *args):
+            record("coordinator_registry_steps")
+            return self.actual.pop(key, *args)
+
+        def values(self):
+            record("coordinator_registry_enumerations")
+            return self.actual.values()
+
+        def items(self):
+            record("coordinator_registry_enumerations")
+            return self.actual.items()
+
+        def keys(self):
+            record("coordinator_registry_enumerations")
+            return self.actual.keys()
+
+        def copy(self):
+            record("coordinator_registry_enumerations")
+            return self.actual.copy()
+
+    class WeakRegistry:
+        def __init__(self, actual):
+            self.actual = actual
+
+        def add(self, value):
+            record("coordinator_registry_steps")
+            return self.actual.add(value)
+
+        def discard(self, value):
+            record("coordinator_registry_steps")
+            return self.actual.discard(value)
+
+        def __len__(self):
+            record("coordinator_registry_steps")
+            return len(self.actual)
+
+        def __contains__(self, value):
+            record("coordinator_registry_steps")
+            return value in self.actual
+
+        def __iter__(self):
+            record("coordinator_registry_enumerations")
+            return iter(self.actual)
+
+        def __getattr__(self, name):
+            return getattr(self.actual, name)
+
+    class PendingRemovals:
+        def __init__(self, actual):
+            self.actual = actual
+
+        def __len__(self):
+            record("coordinator_registry_steps")
+            return len(self.actual)
+
+        def pop(self, *args):
+            record("coordinator_weakref_cleanup_steps")
+            return self.actual.pop(*args)
+
+        def append(self, value):
+            record("coordinator_weakref_retirements")
+            return self.actual.append(value)
+
+        def __iter__(self):
+            record("coordinator_registry_enumerations")
+            return iter(self.actual)
+
+    class WeakData:
+        def __init__(self, actual):
+            self.actual = actual
+
+        def discard(self, value):
+            record("coordinator_weakref_retirements")
+            return self.actual.discard(value)
+
+        def __len__(self):
+            record("coordinator_registry_steps")
+            return len(self.actual)
+
+        def __contains__(self, value):
+            record("coordinator_registry_steps")
+            return value in self.actual
+
+        def __iter__(self):
+            record("coordinator_registry_enumerations")
+            return iter(self.actual)
+
+        def __getattr__(self, name):
+            return getattr(self.actual, name)
+
+    actual_is_set = threading.Event.is_set
+
+    def is_set(event):
+        record("acknowledgement_probes")
+        return actual_is_set(event)
+
+    with monkeypatch.context() as patch:
+        dangling = threading._dangling
+        patch.setattr(dangling, "_pending_removals", PendingRemovals(dangling._pending_removals))
+        patch.setattr(dangling, "data", WeakData(dangling.data))
