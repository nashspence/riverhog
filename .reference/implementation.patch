diff --git a/packages/retained-resource/native/worker.c b/packages/retained-resource/native/worker.c
new file mode 100644
index 0000000000000000000000000000000000000000..3c55d9584f0c0aaa347026518d165c7edd8554e7
--- /dev/null
+++ b/packages/retained-resource/native/worker.c
@@ -0,0 +1,507 @@
+#define PY_SSIZE_T_CLEAN
+#define _GNU_SOURCE
+#include <Python.h>
+#include <errno.h>
+#include <string.h>
+#ifdef _WIN32
+#if !defined(_MSC_VER) || !defined(_DLL)
+#error "Windows workers require supported CPython's dynamic UCRT profile."
+#endif
+#include <windows.h>
+#include <process.h>
+#else
+#include <unistd.h>
+#if defined(__linux__)
+#include <pthread.h>
+#include <sys/syscall.h>
+#ifdef RETAINED_RESOURCE_TESTING
+#include <stdatomic.h>
+#include <time.h>
+#endif
+#endif
+#endif
+
+#ifdef Py_GIL_DISABLED
+#error "The worker receiving backend requires GIL-enabled CPython."
+#endif
+
+/* A retained joinable OS worker, not a Python target-return sentinel.  The
+   original object owns the native handle and a self-pin until explicit receipt.
+   Neither object destruction nor callback completion performs receiving. */
+typedef enum { WORKER_NEW, WORKER_STARTED, WORKER_RECEIVED, WORKER_UNKNOWN } WorkerState;
+typedef struct {
+    PyObject_HEAD
+    PyObject *target;
+    PyObject *exception;
+    PyInterpreterState *interpreter;
+    unsigned long process_id, native_id;
+    unsigned long start_calls, poll_calls, join_calls, wait_calls, close_calls, exit_receipts;
+    WorkerState state;
+    int self_pin, fault, native_error, exit_observed;
+#ifdef _WIN32
+    HANDLE handle;
+    unsigned int thread_id;
+#elif defined(__linux__)
+    pthread_t handle;
+#ifdef RETAINED_RESOURCE_TESTING
+    int test_hold_native_tail;
+    _Atomic int test_tail_entered, test_tail_released, test_tail_timed_out, test_tail_error;
+#endif
+#endif
+} WorkerHandle;
+
+#if defined(RETAINED_RESOURCE_TESTING) && defined(__linux__)
+static pthread_key_t test_tail_key;
+static pthread_once_t test_tail_once = PTHREAD_ONCE_INIT;
+static int test_tail_key_error;
+
+static void test_native_tail_destructor(void *argument) {
+    WorkerHandle *self = (WorkerHandle *)argument;
+    struct timespec begun, now, pause = {0, 1000000};
+    if (clock_gettime(CLOCK_MONOTONIC, &begun) != 0) {
+        atomic_store(&self->test_tail_error, errno);
+        return;
+    }
+    atomic_store(&self->test_tail_entered, 1);
+    /* A test-only safety deadline keeps a failed witness from owning a process
+       forever.  The test checks that explicit release, not this limit, ended it. */
+    while (!atomic_load(&self->test_tail_released)) {
+        if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+            atomic_store(&self->test_tail_error, errno);
+            return;
+        }
+        if (now.tv_sec - begun.tv_sec >= 5) {
+            atomic_store(&self->test_tail_timed_out, 1);
+            return;
+        }
+        (void)nanosleep(&pause, NULL);
+    }
+}
+
+static void test_tail_initialize(void) {
+    test_tail_key_error = pthread_key_create(&test_tail_key, test_native_tail_destructor);
+}
+#endif
+
+static unsigned long worker_process_id(void) {
+#ifdef _WIN32
+    return GetCurrentProcessId();
+#else
+    return (unsigned long)getpid();
+#endif
+}
+
+static PyObject *worker_fail(const char *message) {
+    PyErr_SetString(PyExc_RuntimeError, message);
+    return NULL;
+}
+
+static int worker_origin(WorkerHandle *self) {
+    if (self->process_id != worker_process_id() ||
+        self->interpreter != PyThreadState_GetInterpreter(PyThreadState_Get())) {
+        PyErr_SetString(PyExc_RuntimeError,
+                        "worker belongs to its original process and interpreter");
+        return 0;
+    }
+    return 1;
+}
+
+static int worker_is_current_native(WorkerHandle *self) {
+    /* Quarantined handles are never probed again, even for diagnostics. */
+    if (self->state != WORKER_STARTED) return 0;
+    if (self->exit_observed) return 0;
+#ifdef _WIN32
+    if (self->thread_id != GetCurrentThreadId()) return 0;
+    /* Windows may reuse the numeric ID while our original HANDLE remains
+       open.  A signaled original object cannot identify the calling thread. */
+    self->wait_calls++;
+    DWORD outcome = WaitForSingleObject(self->handle, 0);
+    if (outcome == WAIT_TIMEOUT) return 1;
+    if (outcome == WAIT_OBJECT_0) {
+        self->exit_observed = 1;
+        self->exit_receipts++;
+        return 0;
+    }
+    self->native_error = (int)GetLastError();
+    self->state = WORKER_UNKNOWN;
+    PyErr_SetString(PyExc_RuntimeError,
+                    "native worker identity wait failed; original handle remains retained");
+    return -1;
+#elif defined(__linux__)
+    return pthread_equal(self->handle, pthread_self());
+#else
+    return 0;
+#endif
+}
+
+#if defined(__linux__) || defined(_WIN32)
+static void worker_call(WorkerHandle *self) {
+    PyGILState_STATE gil = PyGILState_Ensure();
+#ifdef _WIN32
+    self->native_id = GetCurrentThreadId();
+#else
+    self->native_id = (unsigned long)syscall(SYS_gettid);
+#endif
+    PyObject *result = PyObject_CallNoArgs(self->target);
+    if (result == NULL) {
+        /* A caller may publish its own Future.  Unexpected callback failure is
+           retained separately, never translated into successful completion. */
+        self->exception = PyErr_GetRaisedException();
+    } else {
+        Py_DECREF(result);
+    }
+    Py_CLEAR(self->target);
+#if defined(RETAINED_RESOURCE_TESTING) && defined(__linux__)
+    if (self->test_hold_native_tail) {
+        atomic_store(&self->test_tail_error, pthread_setspecific(test_tail_key, self));
+    }
+#endif
+    /* This clears the original thread state, including Python thread-local
+       finalizers.  Native TLS destructors still run after this function returns;
+       only the OS join/wait below is an exit receipt. */
+    PyGILState_Release(gil);
+}
+
+#ifdef _WIN32
+static unsigned int __stdcall worker_entry(void *argument) {
+    worker_call((WorkerHandle *)argument);
+    return 0;
+}
+#else
+static void *worker_entry(void *argument) {
+    worker_call((WorkerHandle *)argument);
+    return NULL;
+}
+#endif
+#endif
+
+static PyObject *worker_new(PyTypeObject *type, PyObject *args, PyObject *kwargs) {
+    PyObject *target;
+    static char *keys[] = {"target", NULL};
+    if (!PyArg_ParseTupleAndKeywords(args, kwargs, "O", keys, &target)) return NULL;
+    if (!PyCallable_Check(target)) {
+        PyErr_SetString(PyExc_TypeError, "worker target must be callable");
+        return NULL;
+    }
+    /* PyGILState_Ensure is a main-interpreter API.  Refuse before native effects
+       instead of silently attaching a callback to a different interpreter. */
+    PyInterpreterState *interpreter = PyThreadState_GetInterpreter(PyThreadState_Get());
+    if (interpreter != PyInterpreterState_Main())
+        return worker_fail("native workers require the original main interpreter");
+#if !defined(__linux__) && !defined(_WIN32)
+    (void)type;
+    return worker_fail("bounded native worker receiving requires Linux pthread_tryjoin_np or Windows UCRT; no Darwin backend is qualified");
+#else
+    WorkerHandle *self = (WorkerHandle *)type->tp_alloc(type, 0);
+    if (self == NULL) return NULL;
+    self->target = Py_NewRef(target);
+    self->interpreter = interpreter;
+    self->process_id = worker_process_id();
+    self->state = WORKER_NEW;
+#if defined(RETAINED_RESOURCE_TESTING) && defined(__linux__)
+    atomic_init(&self->test_tail_entered, 0);
+    atomic_init(&self->test_tail_released, 0);
+    atomic_init(&self->test_tail_timed_out, 0);
+    atomic_init(&self->test_tail_error, 0);
+#endif
+    return (PyObject *)self;
+#endif
+}
+
+static int worker_traverse(WorkerHandle *self, visitproc visit, void *arg) {
+    Py_VISIT(self->target);
+    Py_VISIT(self->exception);
+    return 0;
+}
+
+static int worker_clear(WorkerHandle *self) {
+    /* The native self-pin is an external reference in the GC graph.  In-flight
+       callbacks and quarantined owners therefore cannot be cycle-collected.
+       Unstarted/received callback and traceback cycles may be released safely. */
+    if (!self->self_pin) {
+        Py_CLEAR(self->target);
+        Py_CLEAR(self->exception);
+    }
+    return 0;
+}
+
+static void worker_dealloc(WorkerHandle *self) {
+    /* An unreceived started worker has a native self-pin.  Caller abandonment
+       leaks that charged owner rather than freeing a live handle or callback. */
+    PyObject_GC_UnTrack(self);
+    worker_clear(self);
+    Py_TYPE(self)->tp_free((PyObject *)self);
+}
+
+static int worker_take_fault(WorkerHandle *self, int starting) {
+    int fault = self->fault;
+    int start_fault = fault >= 1 && fault <= 3;
+    if (fault != 0 && start_fault == starting) {
+        self->fault = 0;
+        return fault;
+    }
+    return 0;
+}
+
+static int worker_reply(WorkerHandle *self, int fault, int starting) {
+    (void)self;
+    if (fault == (starting ? 2 : 5)) {
+        PyErr_SetString(PyExc_RuntimeError,
+                        starting ? "injected lost start reply; inspect original owner" :
+                                   "injected lost join reply; inspect original owner");
+        return 0;
+    }
+    if (fault == (starting ? 3 : 6)) PyErr_SetInterrupt();
+    return PyErr_CheckSignals() == 0;
+}
+
+static PyObject *worker_start(WorkerHandle *self, PyObject *unused) {
+    (void)unused;
+    if (!worker_origin(self)) return NULL;
+    if (self->state != WORKER_NEW)
+        return worker_fail("worker start is single-attempt; retain the original owner");
+    if (self->target == NULL)
+        return worker_fail("worker target was released before native creation");
+    int fault = worker_take_fault(self, 1);
+    if (fault == 1) return worker_fail("injected before-start refusal; no native worker created");
+#if defined(__linux__) || defined(_WIN32)
+    /* Hold the GIL across the bounded constructor and outcome recording.  The
+       child cannot run Python until its exact handle and self-pin are retained. */
+    Py_INCREF(self);
+    self->self_pin = 1;
+    self->start_calls++;
+#ifdef _WIN32
+    uintptr_t handle = _beginthreadex(NULL, 0, worker_entry, self, 0, &self->thread_id);
+    int error = handle == 0 ? errno : 0;
+    self->handle = (HANDLE)handle;
+#else
+    int error = pthread_create(&self->handle, NULL, worker_entry, self);
+#endif
+    self->native_error = error;
+    if (error != 0) {
+        self->self_pin = 0;
+        Py_DECREF(self);
+        /* A failed constructor has a definite no-worker result and permits the
+           owner to remove its reservation.  Never retry work on this object. */
+        self->state = WORKER_RECEIVED;
+        errno = error;
+        return PyErr_SetFromErrno(PyExc_OSError);
+    }
+    self->state = WORKER_STARTED;
+    if (!worker_reply(self, fault, 1)) return NULL;
+    Py_RETURN_NONE;
+#else
+    return worker_fail("no supported bounded native worker receiving backend");
+#endif
+}
+
+static PyObject *worker_poll(WorkerHandle *self, PyObject *unused) {
+    (void)unused;
+    if (!worker_origin(self)) return NULL;
+    self->poll_calls++;
+    if (self->state == WORKER_RECEIVED) Py_RETURN_TRUE;
+    if (self->state == WORKER_NEW) Py_RETURN_FALSE;
+    if (self->state == WORKER_UNKNOWN)
+        return worker_fail("native worker outcome is unknown; original handle remains retained");
+    int current = worker_is_current_native(self);
+    if (current < 0) return NULL;
+    if (current)
+        return worker_fail("cannot receive the current native worker");
+    int fault = worker_take_fault(self, 0);
+    if (fault == 4) return worker_fail("injected before-join refusal; original remains retained");
+    if (fault == 7) {
+        /* Qualify the fail-closed diagnosis branch, without pretending this
+           injection is evidence about an actual OS join failure. */
+        self->native_error = EIO;
+        self->state = WORKER_UNKNOWN;
+        return worker_fail("injected unknown native outcome; original remains retained");
+    }
+#ifdef _WIN32
+    if (!self->exit_observed) {
+        self->wait_calls++;
+        DWORD outcome = WaitForSingleObject(self->handle, 0);
+        if (outcome == WAIT_TIMEOUT) { self->fault = fault; Py_RETURN_FALSE; }
+        if (outcome != WAIT_OBJECT_0) {
+            self->native_error = (int)GetLastError();
+            self->state = WORKER_UNKNOWN;
+            return worker_fail("native worker wait failed; original handle remains retained");
+        }
+        self->exit_observed = 1;
+        self->exit_receipts++;
+    }
+    self->close_calls++;
+    if (!CloseHandle(self->handle)) {
+        self->native_error = (int)GetLastError();
+        self->state = WORKER_UNKNOWN;
+        return worker_fail("native worker handle close is unknown; original remains retained");
+    }
+    self->handle = NULL;
+#elif defined(__linux__)
+    self->join_calls++;
+    int outcome = pthread_tryjoin_np(self->handle, NULL);
+    if (outcome == EBUSY) { self->fault = fault; Py_RETURN_FALSE; }
+    if (outcome != 0) {
+        self->native_error = outcome;
+        self->state = WORKER_UNKNOWN;
+        return worker_fail("native worker join failed; original handle remains retained");
+    }
+    self->exit_observed = 1;
+    self->exit_receipts++;
+#else
+    return worker_fail("no supported bounded native worker receiving backend");
+#endif
+    /* Store a positive native result before signal delivery or Python reply
+       allocation.  A retry never joins a consumed pthread or reused handle. */
+    self->state = WORKER_RECEIVED;
+    if (self->self_pin) {
+        self->self_pin = 0;
+        Py_DECREF(self);
+    }
+    if (!worker_reply(self, fault, 0)) return NULL;
+    Py_RETURN_TRUE;
+}
+
+static PyObject *worker_started(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    return PyBool_FromLong(self->state != WORKER_NEW &&
+                           !(self->state == WORKER_RECEIVED && self->native_error != 0));
+}
+
+static PyObject *worker_received(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    return PyBool_FromLong(self->state == WORKER_RECEIVED);
+}
+
+static PyObject *worker_native_id(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    if (self->native_id == 0) Py_RETURN_NONE;
+    return PyLong_FromUnsignedLong(self->native_id);
+}
+
+static PyObject *worker_is_current(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    int current = worker_is_current_native(self);
+    if (current < 0) return NULL;
+    return PyBool_FromLong(current);
+}
+
+static PyObject *worker_exception(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    return Py_NewRef(self->exception == NULL ? Py_None : self->exception);
+}
+
+static PyObject *worker_metrics(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    return Py_BuildValue("{s:k,s:k,s:k,s:k,s:k,s:k,s:n,s:i}",
+                        "start_calls", self->start_calls,
+                        "poll_calls", self->poll_calls,
+                        "join_calls", self->join_calls,
+                        "wait_calls", self->wait_calls,
+                        "close_calls", self->close_calls,
+                        "exit_receipts", self->exit_receipts,
+                        "owner_storage_bytes", (Py_ssize_t)sizeof(WorkerHandle),
+                        "retained_native_owners", self->self_pin);
+}
+
+#ifdef RETAINED_RESOURCE_TESTING
+static PyObject *worker_test_fault(WorkerHandle *self, PyObject *argument) {
+    const char *name = PyUnicode_AsUTF8(argument);
+    if (name == NULL || !worker_origin(self)) return NULL;
+    const char *faults[] = {"none", "before_start", "after_start", "signal_after_start",
+                            "before_join", "after_join", "signal_after_join", "unknown_join"};
+    for (int index = 0; index < 8; index++) {
+        if (strcmp(name, faults[index]) == 0) {
+            self->fault = index;
+            Py_RETURN_NONE;
+        }
+    }
+    return worker_fail("unknown worker test seam");
+}
+#ifdef __linux__
+static PyObject *worker_test_native_tail(WorkerHandle *self, PyObject *argument) {
+    const char *action = PyUnicode_AsUTF8(argument);
+    if (action == NULL || !worker_origin(self)) return NULL;
+    if (strcmp(action, "hold") == 0) {
+        if (self->state != WORKER_NEW)
+            return worker_fail("native tail must be held before original worker start");
+        int error = pthread_once(&test_tail_once, test_tail_initialize);
+        if (error == 0) error = test_tail_key_error;
+        if (error != 0) {
+            errno = error;
+            return PyErr_SetFromErrno(PyExc_OSError);
+        }
+        self->test_hold_native_tail = 1;
+    } else if (strcmp(action, "release") == 0) {
+        atomic_store(&self->test_tail_released, 1);
+    } else {
+        return worker_fail("native tail action must be hold or release");
+    }
+    Py_RETURN_NONE;
+}
+
+static PyObject *worker_test_tail_state(WorkerHandle *self, void *closure) {
+    (void)closure;
+    if (!worker_origin(self)) return NULL;
+    return Py_BuildValue("{s:i,s:i,s:i,s:i}",
+                        "entered", atomic_load(&self->test_tail_entered),
+                        "released", atomic_load(&self->test_tail_released),
+                        "timed_out", atomic_load(&self->test_tail_timed_out),
+                        "error", atomic_load(&self->test_tail_error));
+}
+#endif
+#endif
+
+static PyMethodDef worker_methods[] = {
+    {"start", (PyCFunction)worker_start, METH_NOARGS, "Create exactly one retained joinable native worker."},
+    {"poll", (PyCFunction)worker_poll, METH_NOARGS, "Try receiving the original OS worker without waiting."},
+#ifdef RETAINED_RESOURCE_TESTING
+    {"_test_fault", (PyCFunction)worker_test_fault, METH_O, "Only present in the fault-witness build."},
+#ifdef __linux__
+    {"_test_native_tail", (PyCFunction)worker_test_native_tail, METH_O, "Hold actual native TLS destruction in the fault-witness build."},
+#endif
+#endif
+    {NULL, NULL, 0, NULL}
+};
+
+static PyGetSetDef worker_getset[] = {
+    {"started", (getter)worker_started, NULL, NULL, NULL},
+    {"received", (getter)worker_received, NULL, NULL, NULL},
+    {"native_id", (getter)worker_native_id, NULL, NULL, NULL},
+    {"is_current", (getter)worker_is_current, NULL, NULL, NULL},
+    {"exception", (getter)worker_exception, NULL, NULL, NULL},
+    {"metrics", (getter)worker_metrics, NULL, NULL, NULL},
+#if defined(RETAINED_RESOURCE_TESTING) && defined(__linux__)
+    {"_test_native_tail_state", (getter)worker_test_tail_state, NULL, NULL, NULL},
+#endif
+    {NULL, NULL, NULL, NULL, NULL}
+};
+
+static PyTypeObject WorkerHandleType = {PyVarObject_HEAD_INIT(NULL, 0)
+    .tp_name = "retained_resource.WorkerHandle", .tp_basicsize = sizeof(WorkerHandle),
+    .tp_flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_HAVE_GC, .tp_new = worker_new,
+    .tp_dealloc = (destructor)worker_dealloc, .tp_methods = worker_methods,
+    .tp_getset = worker_getset, .tp_traverse = (traverseproc)worker_traverse,
+    .tp_clear = (inquiry)worker_clear
+};
+
+static PyModuleDef worker_module = {PyModuleDef_HEAD_INIT,
+    .m_name = "_worker_native", .m_doc = "Original joinable native worker exit receiving.",
+    .m_size = -1
+};
+
+PyMODINIT_FUNC PyInit__worker_native(void) {
+    if (PyType_Ready(&WorkerHandleType) < 0) return NULL;
+    PyObject *module = PyModule_Create(&worker_module);
+    if (module == NULL) return NULL;
+    if (PyModule_AddObjectRef(module, "WorkerHandle", (PyObject *)&WorkerHandleType) < 0) {
+        Py_DECREF(module);
+        return NULL;
+    }
+    return module;
+}
