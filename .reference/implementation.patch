+@pytest.mark.skipif(not SUPPORTED, reason="bounded worker receiving backend")
+def test_public_thread_initialization_failure_preserves_pending_flag_and_original_error(
+    monkeypatch,
+):
+    from retained_resource import Worker, WorkerBootstrapError
+
+    failure = MemoryError("original runtime registration allocation failed")
+    original_registry = threading._dangling
+    observed = []
+
+    class RefusedRegistry:
+        def add(self, worker):
+            raise failure
+
+        def __getattr__(self, name):
+            return getattr(original_registry, name)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(threading, "_dangling", RefusedRegistry())
