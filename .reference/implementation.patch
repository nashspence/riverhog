+"""Actual native entries for one original worker acquisition or receive probe."""
+
+from riverhog_growth_contracts import (
+    COUNT,
+    Bound,
+    Declaration,
+    Dimension,
+    Expression,
+    declare_growth,
+)
+
+from ._worker_native import WorkerHandle
+
+
+def declaration(operation: str) -> Declaration:
+    starting = operation == "start"
+    limits = {
+        "start_calls": 1 if starting else 0,
+        "poll_calls": 0 if starting else 1,
+        "join_calls": 0 if starting else 1,
+        "wait_calls": 0 if starting else 1,
+        "close_calls": 0 if starting else 1,
+        "exit_receipts": 0 if starting else 1,
+    }
+    return Declaration(
+        id=f"retained-resource.worker-{operation}.growth/v1",
+        authority="retained-resource",
+        subjects=(f"retained_resource.worker_growth.{operation}",),
+        scope="one operation on the exact retained native worker owner",
+        starts_at="caller has retained original worker ownership and capacity",
+        ends_at="recorded native outcome or conservative pending/unknown observation",
+        dimensions=(
+            Dimension("unrelated_workers", COUNT, "Unrelated retained originals, never scanned."),
+        ),
+        bounds=tuple(
+            Bound(
+                name,
+                COUNT,
+                "upper",
+                Expression("constant", value=limit, unit=COUNT),
+                "Actual native API entries or recorded positive OS exit outcomes.",
+            )
+            for name, limit in limits.items()
+        ),
+        conditions=(
+            "GIL-enabled main-interpreter CPython with the admitted native backend.",
+            "Linux joinable pthreads or Windows dynamic-UCRT thread HANDLEs.",
+            "The owner stays in its original process through explicit receiving.",
+        ),
+        invariants=(
+            "Each original admits at most one native worker creation.",
+            "Each original records at most one positive OS exit receipt.",
+            "A received original performs no more joins, waits or handle closes.",
+            "A Future, target return, Python sentinel or thread ID is not an exit receipt.",
+            "Pending probes remain nonblocking and never enumerate unrelated originals.",
+        ),
+        limitations=(
+            "Native API entries do not bound internal scheduler or allocator latency.",
+            "Callback work, Python bootstrap and thread-local finalization are separate scopes.",
+            "No aggregate process memory or wall-clock performance claim.",
+        ),
+    )
+
+
+@declare_growth(declaration("start"))
+def start(owner: WorkerHandle) -> None:
+    owner.start()
+
+
+@declare_growth(declaration("poll"))
+def poll(owner: WorkerHandle) -> bool:
+    return owner.poll()
