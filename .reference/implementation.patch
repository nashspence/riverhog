index 00000000..083dcae8
--- /dev/null
+++ b/packages/retained-resource/tests/test_worker_growth.py
@@ -0,0 +1,244 @@
+"""Count actual native start/receive primitives without timing-based assertions."""
+
+from __future__ import annotations
+
+import os
+import sys
+import threading
+import time
+
+import pytest
+from riverhog_growth_contracts import growth_binding, project_bindings, validate_execution_samples
+
+from scripts.validation_numeric import numeric_policy_from_environment
+from tests.support.worker_coordination import observe_worker_coordination
+from tests.support.workspace_reclamation import execution_sample
+
+pytestmark = pytest.mark.skipif(
+    sys.platform not in {"linux", "win32"}, reason="bounded native worker receiving backend"
+)
+
+
+@pytest.mark.growth_witness(
+    "retained-resource.native-worker-work",
+    gates=("unit", "linux-qualification", "native-ubuntu-24.04", "native-windows-2025"),
+)
+def test_original_worker_receiving_counts_actual_lifetime_primitives(record_property):
+    from retained_resource._worker_native import WorkerHandle
+    from retained_resource.worker_growth import poll, start
+
+    bindings = tuple(growth_binding(operation) for operation in (start, poll))
+    policy = numeric_policy_from_environment(os.environ)
+    projection = project_bindings(bindings, numeric_policy=policy)
+    samples = []
+    owner_widths = set()
+
+    def observe(operation, worker, population):
+        before = worker.metrics
+        result = operation(worker)
+        after = worker.metrics
+        binding = growth_binding(operation)
+        metrics = {
+            bound.metric: after[bound.metric] - before[bound.metric]
+            for bound in binding.declaration.bounds
+        }
+        sample = execution_sample(
+            binding, projection, {"unrelated_workers": population}, metrics, {}
+        )
+        validate_execution_samples(
+            projection, binding.declaration.id, [sample], numeric_policy=policy
+        )
+        samples.append(sample)
+        owner_widths.add(after["owner_storage_bytes"])
+        return result
+
+    for population in (1, 17, 257):
+        unrelated = [WorkerHandle(lambda: None) for _ in range(population)]
+        entered, release = threading.Event(), threading.Event()
+
+        def original(entered=entered, release=release):
+            entered.set()
+            assert release.wait(10)
+
+        worker = WorkerHandle(original)
+        try:
+            observe(start, worker, population)
+            assert entered.wait(5)
+            for _ in range(17):
+                assert not observe(poll, worker, population)
+            pending = worker.metrics
+            assert pending["start_calls"] == 1 and pending["exit_receipts"] == 0
+            assert pending["retained_native_owners"] == 1
+            release.set()
+            deadline = time.monotonic() + 10
+            while not observe(poll, worker, population):
+                assert time.monotonic() < deadline
+                threading.Event().wait(0.001)
+            received = worker.metrics
+            for _ in range(17):
+                assert observe(poll, worker, population)
+            final = worker.metrics
+            assert worker.exception is None
+            assert final["start_calls"] == final["exit_receipts"] == 1
+            assert final["retained_native_owners"] == 0
+            assert all(
+                received[name] == final[name]
+                for name in ("join_calls", "wait_calls", "close_calls")
+            )
+            if sys.platform == "linux":
+                assert final["join_calls"] >= 18
+                assert final["wait_calls"] == final["close_calls"] == 0
+            else:
+                assert final["wait_calls"] >= 18
+                assert final["join_calls"] == 0 and final["close_calls"] == 1
+            assert all(owner.metrics["start_calls"] == 0 for owner in unrelated)
+            owner_widths.update(owner.metrics["owner_storage_bytes"] for owner in unrelated)
+        finally:
+            release.set()
+            deadline = time.monotonic() + 10
+            while not worker.poll():
+                assert time.monotonic() < deadline
+                threading.Event().wait(0.001)
+    assert len(owner_widths) == 1
+    record_property("growth_samples", samples)
+    record_property(
+        "growth_observations",
+        {
+            "operations": len(samples),
+            "owner_storage_bytes": owner_widths.pop(),
+            **{
+                name: sum(sample["metrics"][name] for sample in samples)
+                for name in (
+                    "start_calls",
+                    "poll_calls",
+                    "join_calls",
+                    "wait_calls",
+                    "close_calls",
+                    "exit_receipts",
+                )
+            },
+        },
+    )
+
+
+@pytest.mark.growth_witness(
+    "retained-resource.worker-coordination-work",
+    gates=("unit", "linux-qualification", "native-ubuntu-24.04", "native-windows-2025"),
+)
+def test_public_worker_controls_measure_wait_registry_and_acknowledgement_work(
+    monkeypatch, record_property
+):
+    from retained_resource import Worker, WorkerBootstrapError
+    from retained_resource.worker_growth import construct_worker, poll_worker, start_worker
+
+    operations = (construct_worker, start_worker, poll_worker)
+    policy = numeric_policy_from_environment(os.environ)
+    projection = project_bindings(
+        tuple(growth_binding(operation) for operation in operations), numeric_policy=policy
+    )
+    samples = []
+
+    def observe(operation, argument, population):
+        binding = growth_binding(operation)
+        before = argument.metrics
+        caught = None
+        with observe_worker_coordination(monkeypatch) as coordination:
+            try:
+                result = operation(argument)
+            except WorkerBootstrapError as error:
+                result, caught = None, error
+        worker = argument
+        after = worker.metrics
+        metrics = {
+            bound.metric: (
+                coordination[bound.metric]
+                if bound.metric in coordination
+                else after[bound.metric] - before[bound.metric]
+            )
+            for bound in binding.declaration.bounds
+        }
+        value = execution_sample(
+            binding, projection, {"unrelated_workers": population}, metrics, {}
+        )
+        validate_execution_samples(
+            projection, binding.declaration.id, [value], numeric_policy=policy
+        )
+        samples.append(value)
+        return caught if caught is not None else result
+
+    def construct(population):
+        binding = growth_binding(construct_worker)
+        with observe_worker_coordination(monkeypatch) as coordination:
+            worker = construct_worker(lambda: None)
+        metrics = {
+            bound.metric: (
+                coordination[bound.metric]
+                if bound.metric in coordination
+                else worker.metrics[bound.metric]
+            )
+            for bound in binding.declaration.bounds
+        }
+        value = execution_sample(
