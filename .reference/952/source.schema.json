{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverhog:reference:952:document-front-matter",
  "title": "Parsed strict YAML front matter; Markdown body is separate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "kind",
    "title",
    "subjects"
  ],
  "properties": {
    "format": {
      "const": "riverhog-release-documentation-document/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "reference",
        "guide"
      ]
    },
    "title": {
      "$ref": "#/$defs/line"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "reference"
          }
        }
      },
      "then": {
        "properties": {
          "subjects": {
            "items": {
              "$ref": "#/$defs/entry"
            }
          }
        }
      },
      "else": {
        "properties": {
          "subjects": {
            "items": {
              "$ref": "#/$defs/target"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "element_id",
            "pointer"
          ],
          "properties": {
            "element_id": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:$|/)"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "element_id",
            "member"
          ],
          "properties": {
            "element_id": {
              "type": "string",
              "minLength": 1
            },
            "member": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "key"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "cli-parameter",
                    "python-parameter",
                    "python-result"
                  ]
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "summary"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "summary": {
          "$ref": "#/$defs/line"
        },
        "body": {
          "type": "string",
          "pattern": "^#"
        }
      }
    }
  }
}
