+def test_magic_readiness_failure_is_an_advertised_http_response(tmp_path: Path) -> None:
+    def unavailable() -> None:
+        raise ValueError("fixture installation changed")
+
+    observer = MagicObserver(
+        cast(FileMagic, SimpleNamespace(verify=unavailable)), image_id="sha256:" + "f" * 64
+    )
+    app = create_magic_app(token="secret", observer=observer, state_root=tmp_path / "state")
+    with TestClient(app) as client:
+        response = client.get("/health/ready")
+        assert response.status_code == 503
+        assert response.json()["error"]["code"] == "service_unavailable"
+        # The owning public endpoint must describe the outcome it actually returns.
+        responses = app.openapi()["paths"]["/health/ready"]["get"]["responses"]
+        assert "503" in responses
+        assert "application/json" in responses["503"]["content"]
